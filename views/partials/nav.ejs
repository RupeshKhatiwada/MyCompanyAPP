              </div>
            </div>
          </details>

          <details class="menu-section" <%= isActive(['/search', '/admin/alerts', '/records/history', '/admin/reports/all', '/admin/reports/payroll-summary', '/records/leakage-guard', '/admin/backup', '/admin/settings', '/admin/windows-kit', '/admin/recycle-bin', '/admin/recovery']) ? 'open' : '' %>>
            <summary class="menu-section-summary">
