                <% if (canAccessModule('vendor_aging')) { %><a class="<%= menuLinkClass(['/records/vendor-aging']) %>" href="/records/vendor-aging"><span><%= t('vendorAgingTitle') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
