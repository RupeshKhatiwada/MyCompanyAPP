            </summary>
            <div class="menu-section-body">
              <div class="menu-section-grid">
                <a class="<%= menuLinkClass(['/admin/workers']) %>" href="/admin/workers"><span><%= t('workers') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a>
                <% if (canAccessModule('staffs')) { %><a class="<%= menuLinkClass(['/admin/staffs']) %>" href="/admin/staffs"><span><%= t('staffsTitle') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <% if (canAccessModule('staffs')) { %><a class="<%= menuLinkClass(['/admin/staff-roles']) %>" href="/admin/staff-roles"><span><%= t('manageStaffRoles') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <% if (canAccessModule('attendance')) { %><a class="<%= menuLinkClass(['/admin/worker-attendance']) %>" href="/admin/worker-attendance"><span><%= t('workerAttendanceTitle') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <a class="<%= menuLinkClass(['/admin/profile']) %>" href="/admin/profile"><span><%= t('profileTitle') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a>
                <% if (isSuper) { %><a class="<%= menuLinkClass(['/admin/admins']) %>" href="/admin/admins"><span><%= t('admins') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
              </div>
            </div>
          </details>

          <details class="menu-section" <%= isActive(['/admin/vehicles', '/records/company-vehicle-report', '/records/water-tests', '/records/cleaning-routines', '/worker']) ? 'open' : '' %>>
