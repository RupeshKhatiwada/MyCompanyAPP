            </summary>
            <div class="menu-section-body">
              <div class="menu-section-grid">
                <% if (canAccessModule('vehicles')) { %><a class="<%= menuLinkClass(['/admin/vehicles']) %>" href="/admin/vehicles"><span><%= t('vehicles') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <% if (canAccessModule('vehicles')) { %><a class="<%= menuLinkClass(['/records/company-vehicle-report']) %>" href="/records/company-vehicle-report"><span><%= t('companyVehicleReportTitle') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
