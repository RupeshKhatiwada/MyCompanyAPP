  <script>
    (function () {
      var toggle = document.getElementById('menuToggle');
      var panel = document.getElementById('menuPanel');
      if (!toggle || !panel) return;
      function initAccordion() {
        var sections = panel.querySelectorAll('.menu-section');
        if (!sections.length) return;
        sections.forEach(function (section) {
          if (section.dataset.ready === '1') return;
          section.dataset.ready = '1';
          section.addEventListener('toggle', function () {
            if (!section.open) return;
            sections.forEach(function (other) {
              if (other !== section) other.open = false;
            });
          });
        });
      }
      function openPanel() {
        initAccordion();
        panel.hidden = false;
        panel.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
      }
      function closePanel() {
        panel.classList.add('hidden');
        panel.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      }
      toggle.addEventListener('click', function () {
        if (panel.hidden || panel.classList.contains('hidden')) {
          openPanel();
        } else {
          closePanel();
        }
      });
      panel.addEventListener('click', function (event) {
        if (event.target && event.target.dataset && event.target.dataset.close !== undefined) {
          closePanel();
        }
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closePanel();
      });
    })();
  </script>
<% } %>
<script>
  (function () {
    function setActive(buttons, matcher) {
      buttons.forEach(function (btn) {
        if (matcher(btn)) btn.classList.add('preference-toggle-active');
        else btn.classList.remove('preference-toggle-active');
      });
    }

    function initFontToggles() {
      var buttons = Array.prototype.slice.call(document.querySelectorAll('.font-size-toggle'));
      if (!buttons.length) return;
      function apply(size) {
        var safe = size || 'md';
        document.documentElement.dataset.fontSize = safe;
        try { localStorage.setItem('fontSize', safe); } catch (e) {}
        setActive(buttons, function (btn) { return btn.dataset.fontSize === safe; });
      }
      apply(document.documentElement.dataset.fontSize || 'md');
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          apply(btn.dataset.fontSize || 'md');
        });
      });
    }

    function initThemeToggles() {
      var buttons = Array.prototype.slice.call(document.querySelectorAll('.theme-toggle'));
      if (!buttons.length) return;
      function apply(theme) {
        var allowed = ['classic', 'ocean', 'slate', 'sunrise', 'forest'];
        var safe = allowed.indexOf(theme) >= 0 ? theme : 'classic';
        document.documentElement.dataset.theme = safe;
        try { localStorage.setItem('themePreset', safe); } catch (e) {}
        document.querySelectorAll('input[name="theme_preset"]').forEach(function (input) {
          input.value = safe;
        });
        setActive(buttons, function (btn) { return btn.dataset.theme === safe; });
      }
      apply(document.documentElement.dataset.theme || 'classic');
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          apply(btn.dataset.theme || 'classic');
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initFontToggles();
        initThemeToggles();
      });
    } else {
      initFontToggles();
      initThemeToggles();
    }
  })();
</script>
