<%
  const user = currentUser;
  const isAdmin = user && (user.role === 'ADMIN' || user.role === 'SUPER_ADMIN');
  const isSuper = user && user.role === 'SUPER_ADMIN';
  const roleLabel = user ? (user.role === 'SUPER_ADMIN' ? t('roleSuper') : user.role === 'ADMIN' ? t('roleAdmin') : t('workersTitle')) : '';
  const canAccessModule = (moduleKey, action = 'view') => (typeof canModuleAccess === 'function' ? canModuleAccess(moduleKey, action) : true);
  const current = currentPath || '';
  const isActive = (patterns = []) => patterns.some((pattern) => {
    if (!pattern) return false;
    return current === pattern || current.startsWith(`${pattern}/`);
  });
  const menuLinkClass = (patterns = []) => `menu-link${isActive(patterns) ? ' is-active' : ''}`;
  const shortcutClass = (patterns = []) => `app-shortcut${isActive(patterns) ? ' is-active' : ''}`;
  const shortcutLinks = [
    canAccessModule('exports') ? { href: '/records/exports', label: t('exports'), patterns: ['/records/exports'] } : null,
    canAccessModule('credits') ? { href: '/records/credits', label: t('credits'), patterns: ['/records/credits'] } : null,
    canAccessModule('jar_sales') ? { href: '/records/jar-sales', label: t('jarSalesTitle'), patterns: ['/records/jar-sales'] } : null,
    canAccessModule('history') ? { href: '/records/payment-history', label: t('paymentHistoryTitle'), patterns: ['/records/payment-history'] } : null
  ].filter(Boolean);
  const escapeHtml = (value) => String(value || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
  const menuSectionIconPaths = {
    sales: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/>',
    workforce: '<path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9.5" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    operations: '<path d="M10 17H5a2 2 0 0 1-2-2V6h11v11"/><path d="M14 9h4l3 4v4h-3"/><path d="M14 17h1"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>',
    expenses: '<path d="M6 2h12v20l-3-2-3 2-3-2-3 2V2z"/><path d="M9 7h6"/><path d="M9 11h6"/><path d="M9 15h4"/>',
    income: '<circle cx="12" cy="12" r="8"/><path d="M12 8v8"/><path d="M8 12h8"/>',
    inventory: '<path d="M21 8 12 3 3 8l9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>',
    reports: '<path d="M4 19V5"/><path d="M4 19h16"/><path d="M8 16v-5"/><path d="M12 16V8"/><path d="M16 16v-3"/>'
  };
  const menuSectionLabel = (iconKey, label) => {
    const paths = menuSectionIconPaths[iconKey] || menuSectionIconPaths.reports;
    return `<span class="menu-section-title"><span class="menu-section-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">${paths}</svg></span><span>${escapeHtml(label)}</span></span>`;
  };
%>
<header class="app-header sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-3">
    <div class="flex items-center gap-3">
      <a class="flex items-center gap-3" href="/">
        <div class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-white">
          <% if (logoPath) { %>
            <img src="<%= logoPath %>" alt="logo" class="h-10 w-10 object-contain" />
          <% } else { %>
            <span class="text-sm font-bold text-aqua-700">A</span>
          <% } %>
        </div>
        <div>
          <p class="text-lg font-semibold"><%= brandName || 'AQUA MSK' %></p>
          <p class="text-xs text-slate-500"><%= brandTaglineText || t('brandTagline') %></p>
        </div>
      </a>
      <% if (isSuper) { %>
        <a class="btn-outline btn-sm" href="/admin/settings#branding-settings"><%= t('editBranding') %></a>
      <% } %>
    </div>

    <% if (shortcutLinks.length) { %>
      <div class="app-shortcuts">
        <% shortcutLinks.forEach((link) => { %>
          <a class="<%= shortcutClass(link.patterns) %>" href="<%= link.href %>"><%= link.label %></a>
        <% }) %>
      </div>
    <% } %>

    <div class="flex items-center gap-2">
      <div class="hidden text-right sm:block">
        <p class="text-sm font-semibold"><%= user ? user.full_name : '' %></p>
        <p class="text-xs text-slate-500"><%= roleLabel %></p>
      </div>
      <% if (user) { %>
        <button id="menuToggle" class="btn-outline" type="button" aria-haspopup="true" aria-expanded="false">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <span class="text-xs font-semibold"><%= t('menu') %></span>
        </button>
      <% } %>
      <form method="post" action="/logout" onsubmit="return confirm('<%= t('logoutConfirm') %>');">
        <button class="btn-outline" type="submit">Logout</button>
      </form>
    </div>
  </div>
</header>

<% if (user) { %>
  <div id="menuPanel" class="fixed inset-0 z-50 hidden" hidden>
    <div class="absolute inset-0 bg-slate-900/30" data-close></div>
    <div class="absolute right-4 top-4 w-full max-w-sm drawer p-4">
      <div class="flex items-start justify-between gap-3 border-b border-slate-200 pb-4">
        <div>
          <p class="text-sm font-semibold text-slate-900"><%= user.full_name %></p>
          <p class="mt-1 text-xs text-slate-500"><%= roleLabel %> • <%= brandName || 'AQUA MSK' %></p>
        </div>
        <button class="btn-outline btn-sm" type="button" data-close><%= t('close') %></button>
      </div>

      <% if (shortcutLinks.length) { %>
        <div class="mt-4">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('quickActions') %></p>
          <div class="grid gap-1.5 sm:grid-cols-2">
            <% shortcutLinks.forEach((link) => { %>
              <a class="<%= menuLinkClass(link.patterns) %>" href="<%= link.href %>">
                <span><%= link.label %></span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/>
                </svg>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="mt-4 text-sm menu-accordion">
        <% if (isAdmin) { %>
          <details class="menu-section" <%= isActive(['/records/exports', '/records/credits', '/records/customers', '/records/jar-sales', '/admin/savings', '/records/reconciliation', '/records/customer-invoice', '/records/vehicle-invoice', '/records/payment-history']) ? 'open' : '' %>>
