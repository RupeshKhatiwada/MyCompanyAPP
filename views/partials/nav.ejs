            </summary>
            <div class="menu-section-body">
              <div class="menu-section-grid">
                <% if (canAccessModule('exports')) { %><a class="<%= menuLinkClass(['/records/exports']) %>" href="/records/exports"><span><%= t('exports') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <% if (canAccessModule('credits')) { %><a class="<%= menuLinkClass(['/records/credits']) %>" href="/records/credits"><span><%= t('credits') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <% if (canAccessModule('credits')) { %><a class="<%= menuLinkClass(['/records/customers']) %>" href="/records/customers"><span><%= t('customers') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <% if (canAccessModule('jar_sales')) { %><a class="<%= menuLinkClass(['/records/jar-sales']) %>" href="/records/jar-sales"><span><%= t('jarSalesTitle') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <% if (canAccessModule('savings')) { %><a class="<%= menuLinkClass(['/admin/savings']) %>" href="/admin/savings"><span><%= t('savingsTitle') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <% if (canAccessModule('reconciliation')) { %><a class="<%= menuLinkClass(['/records/reconciliation']) %>" href="/records/reconciliation"><span><%= t('reconciliationTitle') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <% if (canAccessModule('invoices')) { %><a class="<%= menuLinkClass(['/records/customer-invoice']) %>" href="/records/customer-invoice"><span><%= t('customerInvoiceTitle') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <% if (canAccessModule('invoices')) { %><a class="<%= menuLinkClass(['/records/vehicle-invoice']) %>" href="/records/vehicle-invoice"><span><%= t('vehicleInvoiceTitle') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
                <% if (canAccessModule('history')) { %><a class="<%= menuLinkClass(['/records/payment-history']) %>" href="/records/payment-history"><span><%= t('allPaymentHistoryTitle') %></span><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg></a><% } %>
              </div>
            </div>
          </details>

          <details class="menu-section" <%= isActive(['/admin/workers', '/admin/staffs', '/admin/staff-roles', '/admin/worker-attendance', '/admin/profile', '/admin/admins']) ? 'open' : '' %>>
            <summary class="menu-section-summary">
              <%- menuSectionLabel('workforce', t('menuWorkforce')) %>
