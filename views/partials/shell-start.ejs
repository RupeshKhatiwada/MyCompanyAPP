<!DOCTYPE html>
<html lang="<%= lang %>" data-calendar-mode="<%= calendarMode || 'AD' %>" data-calendar-available="<%= canConvertBs ? '1' : '0' %>" data-theme="<%= (currentUser && currentUser.theme_preset) ? currentUser.theme_preset : 'classic' %>" data-font-size="md">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | AQUA MSK</title>
  <script>
    (function () {
      var root = document.documentElement;
      var serverTheme = "<%= (currentUser && currentUser.theme_preset) ? currentUser.theme_preset : '' %>";
      if (serverTheme) {
        root.dataset.theme = serverTheme;
        try {
          localStorage.setItem('themePreset', serverTheme);
        } catch (e) {}
      } else {
        try {
          root.dataset.theme = localStorage.getItem('themePreset') || 'classic';
        } catch (e) {
          root.dataset.theme = 'classic';
        }
      }
      try {
        root.dataset.fontSize = localStorage.getItem('fontSize') || 'md';
      } catch (e) {
        root.dataset.fontSize = 'md';
      }
    })();
  </script>
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
  <script src="/js/calendar-ui.js?v=<%= assetVersion %>" defer></script>
  <style>
    :root[data-font-size="sm"] { font-size: 14px; }
    :root[data-font-size="md"] { font-size: 16px; }
    :root[data-font-size="lg"] { font-size: 18px; }
    :root[data-font-size="xl"] { font-size: 20px; }
    .print-only { display: none; }
    .action-menu { position: relative; display: inline-block; overflow: visible; }
    .action-menu[open] { z-index: 20000; }
    .action-menu > summary { list-style: none; }
    .action-menu > summary::-webkit-details-marker { display: none; }
    .action-menu-panel {
      position: fixed;
      right: auto;
      top: 0;
      left: 0;
      min-width: 180px;
      max-width: min(220px, calc(100vw - 1.5rem));
      max-height: min(320px, calc(100vh - 1rem));
      border: 1px solid rgba(226, 232, 240, 0.9);
      background: #fff;
      border-radius: 0.75rem;
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.14);
      padding: 6px;
      overflow-y: auto;
      overscroll-behavior: contain;
      z-index: 20010;
    }
    .action-menu-item {
      display: block;
      width: 100%;
      text-align: left;
      padding: 8px 10px;
      font-size: 0.85rem;
      border-radius: 0.5rem;
      color: #0f172a;
    }
    .action-menu-item:hover {
      background: #f1f5f9;
    }
    .action-menu-danger {
      color: #b91c1c;
    }
    .action-menu-danger:hover {
      background: #fee2e2;
    }
    .table-action-sticky {
      position: sticky;
      right: 0;
      z-index: 2;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: -6px 0 8px -8px rgba(15, 23, 42, 0.25);
      overflow: visible;
    }
    .table-head .table-action-sticky {
      background: rgba(241, 245, 249, 0.98);
      z-index: 3;
    }
    .table-scroll-region {
      position: relative;
      overflow-x: auto;
      overflow-y: auto !important;
      max-height: min(72vh, calc(100dvh - 220px));
      scrollbar-gutter: stable both-edges;
    }
    .table-scroll-region.is-collapsed {
      max-height: var(--table-collapsed-height, 286px);
    }
    .table-scroll-region[data-menu-open="1"] {
      overflow: visible !important;
      max-height: none !important;
    }
    .table-scroll-controls {
      margin-bottom: 0.5rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: flex-end;
      align-items: center;
    }
    .table-scroll-note {
      font-size: 0.78rem;
      color: #64748b;
    }
    .table-scroll-toggle {
      border: 1px solid rgba(148, 163, 184, 0.65);
      background: #fff;
      color: #0f172a;
      border-radius: 0.75rem;
      padding: 0.35rem 0.7rem;
      font-size: 0.78rem;
      font-weight: 600;
      line-height: 1.1;
      cursor: pointer;
    }
    .table-scroll-toggle:hover {
      background: #f8fafc;
      border-color: rgba(100, 116, 139, 0.7);
    }
    @media print {
      .print-only { display: block !important; }
      .print-hidden { display: none !important; }
    }
  </style>
  <script>
    (function () {
      var selector = "details.action-menu";
      function getMenuPortal() {
        var portal = document.getElementById("actionMenuPortal");
        if (portal) return portal;
        portal = document.createElement("div");
        portal.id = "actionMenuPortal";
        portal.style.position = "fixed";
        portal.style.inset = "0";
        portal.style.zIndex = "21000";
        portal.style.pointerEvents = "none";
        document.body.appendChild(portal);
        return portal;
      }

      function isForcedUp(menu) {
        return menu && menu.dataset && menu.dataset.forceUp === "1";
      }

      function getPanel(menu) {
        if (!(menu instanceof HTMLElement)) return null;
        if (menu.__actionMenuPanel instanceof HTMLElement) {
          return menu.__actionMenuPanel;
        }
        var panel = menu.querySelector(".action-menu-panel");
        if (panel instanceof HTMLElement) {
          menu.__actionMenuPanel = panel;
        }
        return panel instanceof HTMLElement ? panel : null;
      }

      function mountPanel(menu) {
        var panel = getPanel(menu);
        if (!panel) return null;
        var portal = getMenuPortal();
        if (panel.parentNode !== portal) {
          portal.appendChild(panel);
        }
        panel.style.pointerEvents = "auto";
        return panel;
      }

      function restorePanel(menu) {
        var panel = getPanel(menu);
        if (!panel) return;
        if (panel.parentNode !== menu) {
          menu.appendChild(panel);
        }
        panel.style.pointerEvents = "";
      }

      function resetPanelPosition(menu) {
        var panel = getPanel(menu);
        if (!panel) return;
        panel.scrollTop = 0;
        panel.style.position = "";
        panel.style.left = "";
        panel.style.top = "";
        panel.style.right = "";
        panel.style.bottom = "";
        panel.style.maxHeight = "";
        panel.style.width = "";
        panel.style.visibility = "";
        panel.style.display = "";
      }

      function queuePanelReset(menu) {
        var panel = getPanel(menu);
        if (!panel) return;
        panel.scrollTop = 0;
        requestAnimationFrame(function () {
          panel.scrollTop = 0;
          setTimeout(function () {
            panel.scrollTop = 0;
          }, 0);
        });
      }

      function setMenuHostLayer(menu, active) {
        if (!(menu instanceof HTMLElement)) return;
        var host = menu.closest(".table-action-sticky");
        if (!(host instanceof HTMLElement)) return;
        var scrollRegion = host.closest(".table-scroll-region");
        if (active) {
          host.dataset.menuLayer = "active";
          host.style.zIndex = "13020";
          if (scrollRegion instanceof HTMLElement) {
            scrollRegion.dataset.menuOpen = "1";
          }
        } else {
          host.dataset.menuLayer = "";
          host.style.zIndex = "";
          if (scrollRegion instanceof HTMLElement) {
            scrollRegion.dataset.menuOpen = "";
          }
        }
      }

      function closeAll(except) {
        var menus = document.querySelectorAll(selector + "[open]");
        for (var i = 0; i < menus.length; i += 1) {
          if (!except || menus[i] !== except) {
            resetPanelPosition(menus[i]);
            restorePanel(menus[i]);
            setMenuHostLayer(menus[i], false);
            menus[i].classList.remove("action-menu-up");
            menus[i].open = false;
          }
        }
      }

      function closeMenu(menu) {
        if (!(menu instanceof HTMLElement)) return;
        resetPanelPosition(menu);
        restorePanel(menu);
        setMenuHostLayer(menu, false);
        menu.classList.remove("action-menu-up");
        menu.open = false;
      }

      function placeMenu(menu) {
        if (!(menu instanceof HTMLElement)) return;
        var panel = mountPanel(menu);
        if (!(panel instanceof HTMLElement)) return;
        var anchor = menu.querySelector("summary");
        var anchorRect = (anchor instanceof HTMLElement ? anchor : menu).getBoundingClientRect();
        var viewportMargin = 8;
        var gap = 6;

        panel.style.position = "fixed";
        panel.style.left = viewportMargin + "px";
        panel.style.top = viewportMargin + "px";
        panel.style.right = "auto";
        panel.style.bottom = "auto";
        panel.scrollTop = 0;
        panel.style.maxHeight = "";
        panel.style.width = "";
        panel.style.visibility = "hidden";
        panel.style.display = "block";

        var panelRect = panel.getBoundingClientRect();
        var panelWidth = Math.max(panelRect.width || panel.offsetWidth || 180, 180);
        var panelHeight = Math.max(panel.scrollHeight || panelRect.height || 120, 120);

        var spaceBelow = Math.max(0, window.innerHeight - anchorRect.bottom - viewportMargin - gap);
        var spaceAbove = Math.max(0, anchorRect.top - viewportMargin);
        var openUp = isForcedUp(menu) || (panelHeight > spaceBelow && spaceAbove > spaceBelow);

        if (openUp) menu.classList.add("action-menu-up");
        else menu.classList.remove("action-menu-up");

        var availableSpace = Math.max(140, Math.floor(openUp ? spaceAbove : spaceBelow));
        panel.style.maxHeight = availableSpace + "px";
        panel.scrollTop = 0;
        panel.style.display = "block";
        panel.style.visibility = "hidden";
        panelRect = panel.getBoundingClientRect();
        panelWidth = Math.max(panelRect.width || panelWidth, 180);
        panelHeight = Math.min(Math.max(panel.scrollHeight || panelRect.height || 120, 120), availableSpace);

        var left = anchorRect.right - panelWidth;
        left = Math.max(viewportMargin, Math.min(left, window.innerWidth - viewportMargin - panelWidth));
        var top = openUp
          ? (anchorRect.top - panelHeight - gap)
          : (anchorRect.bottom + gap);
        top = Math.max(viewportMargin, Math.min(top, window.innerHeight - viewportMargin - panelHeight));

        panel.style.left = Math.round(left) + "px";
        panel.style.top = Math.round(top) + "px";
        panel.style.right = "auto";
        panel.style.bottom = "auto";
        panel.scrollTop = 0;
        panel.style.visibility = "";
        panel.style.display = "";
        queuePanelReset(menu);
      }

      function openMenu(menu) {
        if (!(menu instanceof HTMLElement)) return;
        closeAll(menu);
        menu.open = true;
        setMenuHostLayer(menu, true);
        placeMenu(menu);
        queuePanelReset(menu);
        requestAnimationFrame(function () {
          if (!menu.open) return;
          placeMenu(menu);
          queuePanelReset(menu);
        });
      }

      document.addEventListener("toggle", function (event) {
        var target = event && event.target;
        if (!(target instanceof HTMLElement)) return;
        if (!target.matches(selector)) return;
        if (target.open) {
          closeAll(target);
          setMenuHostLayer(target, true);
          placeMenu(target);
        } else {
          resetPanelPosition(target);
          restorePanel(target);
          setMenuHostLayer(target, false);
          target.classList.remove("action-menu-up");
        }
      }, true);

      document.addEventListener("click", function (event) {
        var target = event && event.target;
        if (!(target instanceof Element)) return;

        var summary = target.closest(selector + " > summary");
        if (summary instanceof HTMLElement) {
          event.preventDefault();
          event.stopPropagation();
          var menu = summary.parentElement;
          if (!(menu instanceof HTMLElement)) return;
          if (menu.open) closeMenu(menu);
          else openMenu(menu);
          return;
        }

        if (target.closest(".action-menu-panel")) {
          if (target.closest("a, button")) {
            setTimeout(function () {
              closeAll();
            }, 0);
          }
          return;
        }

        if (!target.closest(selector)) closeAll();
      });

      document.addEventListener("keydown", function (event) {
        var target = event && event.target;
        if (
          (event.key === "Enter" || event.key === " ") &&
          target instanceof HTMLElement &&
          target.matches(selector + " > summary")
        ) {
          event.preventDefault();
          target.click();
          return;
        }
        if (event.key === "Escape") closeAll();
      });

      document.addEventListener("scroll", function () {
        var openMenus = document.querySelectorAll(selector + "[open]");
        for (var i = 0; i < openMenus.length; i += 1) {
          placeMenu(openMenus[i]);
        }
      }, true);

      window.addEventListener("resize", function () {
        var openMenus = document.querySelectorAll(selector + "[open]");
        for (var i = 0; i < openMenus.length; i += 1) {
          placeMenu(openMenus[i]);
        }
      });
    })();
    (function () {
      var rowLimit = 4;
      var expandLabel = <%- JSON.stringify(t('maximizeList')) %>;
      var collapseLabel = <%- JSON.stringify(t('showLess')) %>;
      var noteLabel = <%- JSON.stringify(t('showFirstRows')) %>;

      function closestTableRegion(table) {
        if (!(table instanceof HTMLElement)) return null;
        var region = table.closest(".overflow-x-auto");
        if (region && region.contains(table)) return region;
        return null;
      }

      function getRowHeight(row, fallback) {
        if (!(row instanceof HTMLElement)) return fallback;
        var h = Math.round(row.getBoundingClientRect().height || 0);
        return h > 0 ? h : fallback;
      }

      function computeCollapsedHeight(table) {
        var header = table.querySelector("thead");
        var headerHeight = Math.round((header && header.getBoundingClientRect().height) || 0);
        if (headerHeight <= 0) headerHeight = 46;
        var rows = Array.prototype.slice.call(table.querySelectorAll("tbody tr"), 0, rowLimit);
        var rowHeightFallback = 52;
        var rowsHeight = rows.reduce(function (sum, row) {
          return sum + getRowHeight(row, rowHeightFallback);
        }, 0);
        return Math.max(220, headerHeight + rowsHeight + 10);
      }

      function setExpanded(region, button, expanded) {
        if (!(region instanceof HTMLElement)) return;
        if (expanded) {
          region.classList.remove("is-collapsed");
          region.dataset.expanded = "1";
          if (button) button.textContent = collapseLabel;
        } else {
          region.classList.add("is-collapsed");
          region.dataset.expanded = "0";
          if (button) button.textContent = expandLabel;
        }
      }

      function attachControls(table) {
        if (!(table instanceof HTMLElement)) return;
        if (table.dataset.scrollReady === "1") return;
        var region = closestTableRegion(table);
        if (!region) return;
        region.classList.add("table-scroll-region");
        var bodyRows = table.querySelectorAll("tbody tr");
        if (!bodyRows || bodyRows.length <= rowLimit) {
          table.dataset.scrollReady = "1";
          return;
        }

        region.style.setProperty("--table-collapsed-height", computeCollapsedHeight(table) + "px");

        var controls = document.createElement("div");
        controls.className = "table-scroll-controls";
        var note = document.createElement("span");
        note.className = "table-scroll-note";
        note.textContent = noteLabel;
        var button = document.createElement("button");
        button.type = "button";
        button.className = "table-scroll-toggle";
        button.textContent = expandLabel;
        button.setAttribute("aria-expanded", "false");
        button.addEventListener("click", function () {
          var expandNow = region.dataset.expanded !== "1";
          setExpanded(region, button, expandNow);
          button.setAttribute("aria-expanded", expandNow ? "true" : "false");
        });
        controls.appendChild(note);
        controls.appendChild(button);
        region.parentNode.insertBefore(controls, region);

        setExpanded(region, button, false);
        table.dataset.scrollReady = "1";
      }

      document.addEventListener("DOMContentLoaded", function () {
        var tables = document.querySelectorAll("table.table-base");
        for (var i = 0; i < tables.length; i += 1) {
          attachControls(tables[i]);
        }
      });
    })();
  </script>
</head>
<body class="text-slate-900">
  <div class="min-h-screen">
    <%- include('nav') %>
    <main class="mx-auto w-full max-w-[88rem] px-4 pb-16 pt-6">
