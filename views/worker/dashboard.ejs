<%- include('../partials/shell-start', { title }) %>
<section class="py-8">
  <% const alertSummary = workerAlerts || { totalAlerts: 0, lowStockCount: 0, pendingCustomerCount: 0, pendingCustomerAmount: 0, pendingVehicleCount: 0, pendingVehicleAmount: 0 } %>
  <% const range = workerRange || { period: 'day', date: selectedDate || today || '', from: selectedDate || today || '', to: selectedDate || today || '' } %>
  <% const summary = workerSummary || {
    netJarSold: 0,
    netJarContainerSold: 0,
    netBottleCasesSold: 0,
    totalAmountCollected: 0,
    netCollectionAmount: 0,
    totalSalaryGiven: 0,
    totalExpenses: 0,
    companyExpensesTotal: 0,
    vehicleExpensesTotal: 0,
    totalCredit: 0,
    paidByMethod: { cash: 0, bank: 0, eWallet: 0 },
    collectionDeductions: { companyExpenses: 0, vehicleExpenses: 0, salaries: 0, other: 0 },
    creditBreakdown: { exports: 0, customers: 0, jarSales: 0, leakage: 0 },
    openCredits: { customerCount: 0, customerAmount: 0, vehicleCount: 0, vehicleAmount: 0 }
  } %>
  <% const summaryDeductionTotal = (summary.collectionDeductions.companyExpenses || 0) + (summary.collectionDeductions.vehicleExpenses || 0) + (summary.collectionDeductions.salaries || 0) + (summary.collectionDeductions.other || 0); %>
  <% const periodOptions = [
    { key: 'day', label: t('snapshotDaily') },
    { key: 'week', label: t('snapshotWeekly') },
    { key: 'month', label: t('snapshotMonthly') },
    { key: 'year', label: t('snapshotYearly') }
  ] %>

  <div class="dashboard-hero">
    <div class="grid gap-5 xl:grid-cols-[1.15fr_0.85fr] xl:items-start">
      <div>
        <p class="dashboard-kicker"><%= t('dashboard') %></p>
        <h1 class="mt-2 text-3xl font-semibold text-slate-900"><%= t('workerDashboardTitle') %></h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600"><%= t('workerDashboardLead') %></p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="pill"><%= t('selectedRange') %>: <%= formatDateDual(range.from) %> → <%= formatDateDual(range.to) %></span>
          <span class="pill"><%= t('openCredits') %>: <%= (summary.openCredits.customerAmount || 0) + (summary.openCredits.vehicleAmount || 0) %></span>
          <span class="pill"><%= t('alertCenterTitle') %>: <%= alertSummary.totalAlerts %></span>
        </div>
      </div>
      <div class="card card-soft p-5">
        <form class="flex flex-col gap-3" method="get" action="/worker">
          <input type="hidden" name="period" value="<%= range.period %>" />
          <div>
            <label class="label" for="workerDashboardDate"><%= t('date') %></label>
            <input class="input" id="workerDashboardDate" type="date" name="date" value="<%= range.date %>" />
          </div>
          <div class="grid gap-2 sm:grid-cols-4">
            <% periodOptions.forEach((option) => { %>
              <a
                class="<%= range.period === option.key ? 'btn-primary' : 'btn-outline' %> text-center"
                href="/worker?date=<%= encodeURIComponent(range.date) %>&period=<%= option.key %>"
              ><%= option.label %></a>
            <% }) %>
          </div>
          <div class="flex flex-wrap gap-2">
            <button class="btn-primary" type="submit"><%= t('filter') %></button>
            <a class="btn-outline" href="/records/reconciliation/collection-summary/print?from=<%= range.from %>&to=<%= range.to %>" target="_blank"><%= t('printCollectionSummary') %></a>
          </div>
        </form>
        <form class="mt-3 flex flex-col gap-3 sm:flex-row" method="get" action="/search">
          <input class="input flex-1" type="text" name="q" placeholder="<%= t('searchGlobal') %>" />
          <button class="btn-outline sm:min-w-[120px]" type="submit"><%= t('search') %></button>
        </form>
      </div>
    </div>
  </div>

  <div class="mt-6 dashboard-panel">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="dashboard-panel-title"><%= t('collectionSummaryTitle') %></h2>
        <p class="dashboard-panel-subtitle"><%= t('collectionSummaryNote') %></p>
      </div>
      <span class="pill"><%= formatDateDual(range.from) %> → <%= formatDateDual(range.to) %></span>
    </div>
    <div class="money-equation mt-4">
      <div class="money-equation-card is-total">
        <p class="money-equation-label"><%= t('totalAmountCollected') %></p>
        <p class="money-equation-value"><%= summary.totalAmountCollected %></p>
        <p class="money-equation-meta"><%= t('methodCash') %>: <%= summary.paidByMethod.cash || 0 %> • <%= t('methodBank') %>: <%= summary.paidByMethod.bank || 0 %> • <%= t('methodEWallet') %>: <%= summary.paidByMethod.eWallet || 0 %></p>
      </div>
      <div class="money-equation-operator">-</div>
      <div class="money-equation-card is-deduction">
        <p class="money-equation-label"><%= t('collectionDeductions') %></p>
        <p class="money-equation-value"><%= summaryDeductionTotal %></p>
        <p class="money-equation-meta"><%= t('companyPurchasesTitle') %>: <%= summary.collectionDeductions.companyExpenses || 0 %> • <%= t('vehicleExpensesTitle') %>: <%= summary.collectionDeductions.vehicleExpenses || 0 %> • <%= t('salaryPaid') %>: <%= summary.collectionDeductions.salaries || 0 %> • <%= t('otherDeductions') %>: <%= summary.collectionDeductions.other || 0 %></p>
      </div>
      <div class="money-equation-operator">=</div>
      <div class="money-equation-card is-net">
        <p class="money-equation-label"><%= t('expectedNetCollection') %></p>
        <p class="money-equation-value <%= Number(summary.netCollectionAmount || 0) >= 0 ? 'text-emerald-700' : 'text-red-700' %>"><%= summary.netCollectionAmount %></p>
        <p class="money-equation-meta"><%= t('sourceDailyCollection') %></p>
      </div>
    </div>
  </div>

  <div class="mt-6 dashboard-panel">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="dashboard-panel-title"><%= t('quickActions') %></h2>
        <p class="dashboard-panel-subtitle"><%= t('quickActionsWorkerHint') %></p>
      </div>
      <a class="btn-outline relative" href="/records/alerts">
        <span><%= t('alertCenterTitle') %></span>
        <% if (alertSummary.totalAlerts > 0) { %>
          <span class="ml-2 badge bg-red-100 text-red-700"><%= alertSummary.totalAlerts %></span>
        <% } %>
      </a>
    </div>
    <div class="action-grid mt-4">
      <a class="action-card action-card-primary" href="/records/exports/new">
        <p class="action-title"><%= t('addExport') %></p>
        <p class="action-copy"><%= t('dashboardActionExportCopy') %></p>
      </a>
      <a class="action-card" href="/records/credits/new">
        <p class="action-title"><%= t('recordPayment') %> / <%= t('addCredit') %></p>
        <p class="action-copy"><%= t('dashboardActionCreditCopy') %></p>
      </a>
      <a class="action-card" href="/records/staff-attendance">
        <p class="action-title"><%= t('markAttendance') %></p>
        <p class="action-copy"><%= t('dashboardActionAttendanceCopy') %></p>
      </a>
      <a class="action-card" href="/records/company-purchases">
        <p class="action-title"><%= t('addExpense') %></p>
        <p class="action-copy"><%= t('dashboardActionExpenseCopy') %></p>
      </a>
      <a class="action-card" href="/records/imports">
        <p class="action-title"><%= t('updateStock') %></p>
        <p class="action-copy"><%= t('dashboardActionStockCopy') %></p>
      </a>
      <a class="action-card" href="/records/reconciliation?from=<%= range.from %>&to=<%= range.to %>&date=<%= range.date %>">
        <p class="action-title"><%= t('reconciliationTitle') %></p>
        <p class="action-copy"><%= t('dashboardActionReconciliationCopy') %></p>
      </a>
    </div>
  </div>

  <div class="mt-6 dashboard-panel">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="dashboard-panel-title"><%= t('dailyBusinessTitle') %></h2>
        <p class="dashboard-panel-subtitle"><%= t('workerSummaryFocus') %></p>
      </div>
      <span class="pill"><%= formatDateDual(range.from) %> → <%= formatDateDual(range.to) %></span>
    </div>

    <div class="mt-4 metric-grid">
      <div class="metric-card metric-card-emphasis">
        <p class="metric-label"><%= t('netJars') %></p>
        <p class="metric-value"><%= summary.netJarSold %></p>
        <p class="metric-meta"><%= t('rangeTotals') %></p>
      </div>
      <div class="metric-card">
        <p class="metric-label"><%= t('netJarContainerSold') %></p>
        <p class="metric-value"><%= summary.netJarContainerSold %></p>
        <p class="metric-meta"><%= t('rangeTotals') %></p>
      </div>
      <div class="metric-card">
        <p class="metric-label"><%= t('netBottles') %></p>
        <p class="metric-value"><%= summary.netBottleCasesSold %></p>
        <p class="metric-meta"><%= t('rangeTotals') %></p>
      </div>
      <div class="metric-card">
        <p class="metric-label"><%= t('salaryPaid') %></p>
        <p class="metric-value"><%= summary.totalSalaryGiven %></p>
        <p class="metric-meta"><%= t('sourceDailyCollection') %>: <%= summary.collectionDeductions.salaries || 0 %></p>
      </div>
      <div class="metric-card">
        <p class="metric-label"><%= t('totalExpensesCombined') %></p>
        <p class="metric-value"><%= summary.totalExpenses %></p>
        <p class="metric-meta"><%= t('companyPurchasesTitle') %>: <%= summary.companyExpensesTotal || 0 %> • <%= t('vehicleExpensesTitle') %>: <%= summary.vehicleExpensesTotal || 0 %></p>
      </div>
      <div class="metric-card">
        <p class="metric-label"><%= t('totalCreditAmount') %></p>
        <p class="metric-value"><%= summary.totalCredit %></p>
        <p class="metric-meta"><%= t('paymentHistoryTitle') %>: <%= t('rangeTotals') %></p>
      </div>
      <div class="metric-card">
        <p class="metric-label"><%= t('totalAmountCollected') %></p>
        <p class="metric-value"><%= summary.totalAmountCollected %></p>
        <p class="metric-meta"><%= t('methodCash') %>: <%= summary.paidByMethod.cash || 0 %> • <%= t('methodBank') %>: <%= summary.paidByMethod.bank || 0 %> • <%= t('methodEWallet') %>: <%= summary.paidByMethod.eWallet || 0 %></p>
      </div>
      <div class="metric-card">
        <p class="metric-label"><%= t('expectedNetCollection') %></p>
        <p class="metric-value <%= Number(summary.netCollectionAmount || 0) >= 0 ? 'text-emerald-700' : 'text-red-700' %>"><%= summary.netCollectionAmount %></p>
        <p class="metric-meta"><%= t('collectionDeductions') %>: <%= summaryDeductionTotal %></p>
      </div>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-3">
      <div class="card p-5">
        <h3 class="font-semibold"><%= t('cashCollected') %></h3>
        <div class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-500"><%= t('methodCash') %></span>
            <strong><%= summary.paidByMethod.cash || 0 %></strong>
          </div>
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-500"><%= t('methodBank') %></span>
            <strong><%= summary.paidByMethod.bank || 0 %></strong>
          </div>
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-500"><%= t('methodEWallet') %></span>
            <strong><%= summary.paidByMethod.eWallet || 0 %></strong>
          </div>
        </div>
      </div>

      <div class="card p-5">
        <h3 class="font-semibold"><%= t('collectionDeductions') %></h3>
        <div class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-500"><%= t('companyPurchasesTitle') %></span>
            <strong><%= summary.collectionDeductions.companyExpenses || 0 %></strong>
          </div>
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-500"><%= t('vehicleExpensesTitle') %></span>
            <strong><%= summary.collectionDeductions.vehicleExpenses || 0 %></strong>
          </div>
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-500"><%= t('salaryPaid') %></span>
            <strong><%= summary.collectionDeductions.salaries || 0 %></strong>
          </div>
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-500"><%= t('otherDeductions') %></span>
            <strong><%= summary.collectionDeductions.other || 0 %></strong>
          </div>
        </div>
      </div>

      <div class="card p-5">
        <h3 class="font-semibold"><%= t('totalCredits') %></h3>
        <div class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-500"><%= t('exportsTitle') %></span>
            <strong><%= summary.creditBreakdown.exports || 0 %></strong>
          </div>
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-500"><%= t('customerCredits') %></span>
            <strong><%= summary.creditBreakdown.customers || 0 %></strong>
          </div>
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-500"><%= t('jarSalesTitle') %></span>
            <strong><%= summary.creditBreakdown.jarSales || 0 %></strong>
          </div>
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-500"><%= t('leakageJarSalesTitle') %></span>
            <strong><%= summary.creditBreakdown.leakage || 0 %></strong>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 grid gap-4 lg:grid-cols-2">
    <div class="card p-6">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-semibold"><%= t('openCredits') %></h2>
        <a class="btn-outline h-9 px-3 text-xs" href="/records/payment-history?from=<%= range.from %>&to=<%= range.to %>"><%= t('paymentHistoryTitle') %></a>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <div class="card p-4">
          <p class="text-slate-500"><%= t('customerCredits') %></p>
          <p class="text-lg font-semibold"><%= summary.openCredits.customerAmount || 0 %></p>
          <p class="text-xs text-slate-500"><%= t('entries') %>: <%= summary.openCredits.customerCount || 0 %></p>
        </div>
        <div class="card p-4">
          <p class="text-slate-500"><%= t('workerPendingVehicleCredits') %></p>
          <p class="text-lg font-semibold"><%= summary.openCredits.vehicleAmount || 0 %></p>
          <p class="text-xs text-slate-500"><%= t('tripCount') %>: <%= summary.openCredits.vehicleCount || 0 %></p>
        </div>
      </div>
    </div>

    <div class="card p-6">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-semibold"><%= t('snapshotQuickLinks') %></h2>
        <a class="btn-outline h-9 px-3 text-xs" href="/records/history"><%= t('activityLogTitle') %></a>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        <a class="btn-outline" href="/records/exports?from=<%= range.from %>&to=<%= range.to %>"><%= t('viewExports') %></a>
        <a class="btn-outline" href="/records/credits?from=<%= range.from %>&to=<%= range.to %>"><%= t('viewCredits') %></a>
        <a class="btn-outline" href="/records/payment-history?from=<%= range.from %>&to=<%= range.to %>"><%= t('paymentHistoryTitle') %></a>
        <a class="btn-outline" href="/records/reconciliation?from=<%= range.from %>&to=<%= range.to %>&date=<%= range.date %>"><%= t('reconciliationTitle') %></a>
        <a class="btn-outline" href="/records/company-purchases?from=<%= range.from %>&to=<%= range.to %>"><%= t('companyPurchasesTitle') %></a>
        <a class="btn-outline" href="/records/vehicle-expenses?from=<%= range.from %>&to=<%= range.to %>"><%= t('vehicleExpensesTitle') %></a>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/shell-end') %>
