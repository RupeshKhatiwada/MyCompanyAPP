<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('exportSummaryTitle') %> | AQUA MSK</title>
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
  <style>
    <%- include('../partials/print-report-styles', { pageSize: 'A4 landscape' }) %>
  </style>
</head>
<body class="text-slate-900">
  <div class="print-page">
    <div class="print-toolbar print-hidden">
      <button class="btn-primary" onclick="window.print()"><%= t('print') %></button>
    </div>

    <div class="print-header">
      <div class="print-header-copy">
        <%- include('../partials/print-brand', { subtitle: t('exportSummaryTitle') }) %>
        <div class="print-header-meta">
          <span><strong><%= t('from') %>:</strong> <%= from %></span>
          <span><strong><%= t('to') %>:</strong> <%= to %></span>
        </div>
      </div>
    </div>

    <div class="print-section mt-6">
      <div class="print-section-header">
        <div>
          <h2 class="print-section-title"><%= t('exportSummaryTitle') %></h2>
          <p class="print-section-subtitle"><%= t('exportsSubtitle') %></p>
        </div>
      </div>
      <div class="print-table-wrap">
        <table class="print-table">
        <thead class="table-head">
          <tr>
            <th><%= t('date') %></th>
            <th><%= t('vehicle') %></th>
            <th><%= t('jars') %></th>
            <th><%= t('returnJars') %></th>
            <th><%= t('leakageJars') %></th>
            <th><%= t('netJars') %></th>
            <th><%= t('bottleCases') %></th>
            <th><%= t('returnBottleCases') %></th>
            <th><%= t('netBottles') %></th>
            <th><%= t('totalExportAmount') %></th>
            <th><%= t('paidAmount') %></th>
            <th><%= t('creditAmount') %></th>
          </tr>
        </thead>
        <tbody>
          <% if (rows.length === 0) { %>
            <tr>
              <td class="text-slate-500" colspan="12"><%= t('noData') %></td>
            </tr>
          <% } %>
          <% rows.forEach((row) => { %>
            <% const netJars = Math.max(0, (row.jars || 0) - (row.return_jars || 0) - (row.leakage_jars || 0)); %>
            <% const netBottles = Math.max(0, (row.bottles || 0) - (row.return_bottles || 0)); %>
            <tr>
              <td><%= row.export_date %></td>
              <td><strong><%= `${row.owner_name} • ${row.vehicle_number}` %></strong></td>
              <td><%= row.jars %></td>
              <td><%= row.return_jars %></td>
              <td><%= row.leakage_jars %></td>
              <td><%= netJars %></td>
              <td><%= row.bottles %></td>
              <td><%= row.return_bottles %></td>
              <td><%= netBottles %></td>
              <td><%= row.total_amount %></td>
              <td><%= row.paid_amount %></td>
              <td><%= row.credit_amount %></td>
            </tr>
          <% }) %>
        </tbody>
        </table>
      </div>
    </div>

    <div class="print-summary-grid mt-6">
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalJars') %></p>
        <p class="print-summary-value"><%= totals.jars %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalReturnJars') %></p>
        <p class="print-summary-value"><%= totals.return_jars %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalLeakageJars') %></p>
        <p class="print-summary-value"><%= totals.leakage_jars %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalBottleCases') %></p>
        <p class="print-summary-value"><%= totals.bottles %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalReturnBottleCases') %></p>
        <p class="print-summary-value"><%= totals.return_bottles %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalExportAmount') %></p>
        <p class="print-summary-value"><%= totals.total_amount %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalPaidAmount') %></p>
        <p class="print-summary-value"><%= totals.paid_amount %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalCreditAmount') %></p>
        <p class="print-summary-value"><%= totals.credit_amount %></p>
      </div>
    </div>
  </div>
</body>
</html>
