<%- include('../partials/shell-start', { title }) %>
<% const routeBase = typeof vehicleRouteBase === 'string' && vehicleRouteBase ? vehicleRouteBase : '/admin/vehicles'; %>
<% const compliance = vehicleCompliance || {}; %>
<section class="py-8">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-semibold"><%= vehicle ? t('editVehicleTitle') : t('addVehicleTitle') %></h1>
      <p class="text-slate-600"><%= t('vehicleFormSubtitle') %></p>
    </div>
    <a class="btn-outline" href="<%= routeBase %>"><%= t('back') %></a>
  </div>

  <div class="mt-6 card p-6">
    <% if (error) { %>
      <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700"><%= error %></div>
    <% } %>
    <form method="post" action="<%= vehicle ? routeBase + '/' + vehicle.id : routeBase %>" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="label"><%= t('vehicleNumber') %></label>
        <input class="input" type="text" name="vehicle_number" value="<%= vehicle ? vehicle.vehicle_number : '' %>" required />
      </div>
      <div>
        <label class="label" for="owner_name" id="ownerNameLabel"><%= vehicle && vehicle.is_company ? t('driverName') : t('ownerName') %></label>
        <input class="input" type="text" id="owner_name" name="owner_name" value="<%= vehicle ? vehicle.owner_name : '' %>" required />
      </div>
      <div>
        <label class="label"><%= t('phone') %></label>
        <input class="input" type="text" name="phone" value="<%= vehicle ? vehicle.phone || '' : '' %>" />
      </div>
      <div class="flex items-center gap-2">
        <input class="h-4 w-4" type="checkbox" id="is_company" name="is_company" <%= vehicle && vehicle.is_company ? 'checked' : '' %> />
        <label class="label !mb-0" for="is_company"><%= t('companyVehicle') %></label>
      </div>
      <div id="companyComplianceSection" class="space-y-4 rounded-2xl border border-slate-200 bg-slate-50 p-4 <%= vehicle && vehicle.is_company ? '' : 'hidden' %>">
        <div>
          <p class="text-sm font-semibold text-slate-900"><%= t('vehicleComplianceSectionTitle') %></p>
          <p class="mt-1 text-xs text-slate-500"><%= t('vehicleComplianceSectionSubtitle') %></p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <div>
            <label class="label"><%= t('insuranceDetails') %></label>
            <input class="input" type="text" name="insurance_details" value="<%= compliance.insurance_details || '' %>" placeholder="<%= t('insuranceDetailsPlaceholder') %>" />
          </div>
          <div>
            <label class="label"><%= t('insuranceExpiry') %></label>
            <input class="input" type="date" name="insurance_expiry" value="<%= compliance.insurance_expiry || '' %>" />
          </div>
          <div>
            <label class="label"><%= t('permitDetails') %></label>
            <input class="input" type="text" name="permit_details" value="<%= compliance.permit_details || '' %>" placeholder="<%= t('permitDetailsPlaceholder') %>" />
          </div>
          <div>
            <label class="label"><%= t('permitExpiry') %></label>
            <input class="input" type="date" name="permit_expiry" value="<%= compliance.permit_expiry || '' %>" />
          </div>
          <div>
            <label class="label"><%= t('taxExpiry') %></label>
            <input class="input" type="date" name="tax_expiry" value="<%= compliance.tax_expiry || '' %>" />
          </div>
        </div>
        <div>
          <label class="label"><%= t('note') %></label>
          <input class="input" type="text" name="compliance_note" value="<%= compliance.note || '' %>" placeholder="<%= t('vehicleComplianceNotePlaceholder') %>" />
        </div>
      </div>
      <div>
        <label class="label"><%= t('profilePhoto') %></label>
        <input class="input" type="file" name="profile_pic" accept="image/*" />
        <% if (vehicle && vehicle.profile_pic_path) { %>
          <img src="<%= vehicle.profile_pic_path %>" alt="profile" class="mt-3 h-16 w-16 rounded-full object-cover" />
        <% } %>
      </div>
      <button class="btn-primary" type="submit"><%= t('save') %></button>
    </form>
  </div>
</section>
<script>
  (() => {
    const companyCheckbox = document.getElementById("is_company");
    const ownerNameLabel = document.getElementById("ownerNameLabel");
    const companyComplianceSection = document.getElementById("companyComplianceSection");
    if (!companyCheckbox || !ownerNameLabel) return;
    const ownerText = "<%= t('ownerName') %>";
    const driverText = "<%= t('driverName') %>";
    const syncLabel = () => {
      ownerNameLabel.textContent = companyCheckbox.checked ? driverText : ownerText;
      if (companyComplianceSection) {
        companyComplianceSection.classList.toggle("hidden", !companyCheckbox.checked);
      }
    };
    companyCheckbox.addEventListener("change", syncLabel);
    syncLabel();
  })();
</script>
<%- include('../partials/shell-end') %>
