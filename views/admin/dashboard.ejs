<%- include('../partials/shell-start', { title }) %>
<section class="py-8">
  <% const backupText = stats.lastBackupAt ? new Date(stats.lastBackupAt).toLocaleString() : t('backupNever'); %>
  <div class="dashboard-hero">
    <div class="grid gap-5 xl:grid-cols-[1.2fr_0.8fr] xl:items-start">
      <div>
        <p class="dashboard-kicker"><%= t('dashboard') %></p>
        <h1 class="mt-2 text-3xl font-semibold text-slate-900"><%= t('adminDashboard') %></h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600"><%= t('adminDashboardLead') %></p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="pill"><%= t('selectedDate') %>: <%= formatDateDual(snapshotRanges.daily.date) %></span>
          <span class="pill"><%= t('lastBackup') %>: <%= backupText %></span>
          <span class="pill"><%= t('openCredits') %>: <%= stats.outstandingCustomerCredit + stats.outstandingVehicleCredit %></span>
        </div>
      </div>
      <div class="card card-soft p-5">
        <p class="dashboard-kicker"><%= t('search') %></p>
        <p class="mt-2 text-sm text-slate-600"><%= t('dashboardSearchHint') %></p>
        <form class="mt-4 flex flex-col gap-3 sm:flex-row" method="get" action="/search">
          <input class="input flex-1" type="text" name="q" placeholder="<%= t('searchGlobal') %>" />
          <button class="btn-primary sm:min-w-[120px]" type="submit"><%= t('search') %></button>
        </form>
        <div class="mt-4 flex flex-wrap gap-2">
          <a class="btn-outline" href="/admin/alerts"><%= t('alertCenterTitle') %></a>
          <a class="btn-outline" href="/records/history"><%= t('activityLogTitle') %></a>
          <a class="btn-outline" href="/admin/reports/all"><%= t('openSnapshotView') %></a>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 grid gap-4 xl:grid-cols-[1.15fr_0.85fr]">
    <div class="dashboard-panel">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="dashboard-panel-title"><%= t('quickActions') %></h2>
          <p class="dashboard-panel-subtitle"><%= t('quickActionsAdminHint') %></p>
        </div>
      </div>
      <div class="action-grid mt-4">
        <a class="action-card action-card-primary" href="/records/exports/new">
          <p class="action-title"><%= t('addExport') %></p>
          <p class="action-copy"><%= t('dashboardActionExportCopy') %></p>
        </a>
        <a class="action-card" href="/records/credits/new">
          <p class="action-title"><%= t('recordPayment') %> / <%= t('addCredit') %></p>
          <p class="action-copy"><%= t('dashboardActionCreditCopy') %></p>
        </a>
        <a class="action-card" href="/admin/worker-attendance">
          <p class="action-title"><%= t('markAttendance') %></p>
          <p class="action-copy"><%= t('dashboardActionAttendanceCopy') %></p>
        </a>
        <a class="action-card" href="/records/company-purchases">
          <p class="action-title"><%= t('addExpense') %></p>
          <p class="action-copy"><%= t('dashboardActionExpenseCopy') %></p>
        </a>
        <a class="action-card" href="/records/imports">
          <p class="action-title"><%= t('updateStock') %></p>
          <p class="action-copy"><%= t('dashboardActionStockCopy') %></p>
        </a>
        <a class="action-card" href="/admin/reports/all">
          <p class="action-title"><%= t('openSnapshotView') %></p>
          <p class="action-copy"><%= t('dashboardActionSnapshotCopy') %></p>
        </a>
      </div>
    </div>

    <div class="dashboard-panel">
      <p class="dashboard-kicker"><%= t('snapshotViewsTitle') %></p>
      <h2 class="mt-2 text-xl font-semibold text-slate-900"><%= t('officePulseTitle') %></h2>
      <p class="mt-2 text-sm text-slate-600"><%= t('officePulseSubtitle') %></p>
      <div class="dashboard-mini-grid mt-4">
        <div class="metric-card metric-card-emphasis">
          <p class="metric-label"><%= t('todaySales') %></p>
          <p class="metric-value"><%= stats.todaySales || 0 %></p>
          <p class="metric-meta"><%= t('exportsTitle') %>: <%= stats.todayExport.total || 0 %></p>
        </div>
        <div class="metric-card">
          <p class="metric-label"><%= t('monthPaid') %></p>
          <p class="metric-value"><%= stats.monthCombined.paid %></p>
          <p class="metric-meta"><%= t('customerPayments') %>: <%= stats.monthCustomer.paid %></p>
        </div>
        <div class="metric-card">
          <p class="metric-label"><%= t('monthCredit') %></p>
          <p class="metric-value"><%= stats.monthCombined.credit %></p>
          <p class="metric-meta"><%= t('exportsOutstanding') %>: <%= stats.monthExport.credit %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 dashboard-panel">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="dashboard-panel-title"><%= t('snapshotViewsTitle') %></h2>
        <p class="dashboard-panel-subtitle"><%= t('snapshotViewsSubtitle') %></p>
      </div>
      <span class="pill" id="snapshotRangeText"><%= snapshotRanges.daily.from %> → <%= snapshotRanges.daily.to %></span>
    </div>
    <div class="mt-4 flex flex-wrap gap-2" id="snapshotRangeToggle">
      <button
        class="btn-outline snapshot-range-btn"
        type="button"
        data-default-selected="1"
        data-from="<%= snapshotRanges.daily.from %>"
        data-to="<%= snapshotRanges.daily.to %>"
      ><%= t('snapshotDaily') %></button>
      <button
        class="btn-outline snapshot-range-btn"
        type="button"
        data-from="<%= snapshotRanges.weekly.from %>"
        data-to="<%= snapshotRanges.weekly.to %>"
      ><%= t('snapshotWeekly') %></button>
      <button
        class="btn-outline snapshot-range-btn"
        type="button"
        data-from="<%= snapshotRanges.monthly.from %>"
        data-to="<%= snapshotRanges.monthly.to %>"
      ><%= t('snapshotMonthly') %></button>
      <button
        class="btn-outline snapshot-range-btn"
        type="button"
        data-from="<%= snapshotRanges.yearly.from %>"
        data-to="<%= snapshotRanges.yearly.to %>"
      ><%= t('snapshotYearly') %></button>
      <button
        class="btn-outline snapshot-range-btn"
        type="button"
        data-from="<%= snapshotRanges.all.from %>"
        data-to="<%= snapshotRanges.all.to %>"
      ><%= t('snapshotAllTime') %></button>
    </div>
    <form class="mt-3 flex flex-wrap items-center gap-2" id="snapshotRangeForm" method="get" action="/admin/reports/all">
      <input type="hidden" name="from" value="<%= snapshotRanges.daily.from %>" />
      <input type="hidden" name="to" value="<%= snapshotRanges.daily.to %>" />
      <button class="btn-primary" type="submit"><%= t('openSnapshotView') %></button>
    </form>
  </div>

  <% if (stats.backupOverdue) { %>
    <div class="mt-6 card border border-amber-200 bg-amber-50 p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-sm font-semibold text-amber-800"><%= t('backupReminderTitle') %></p>
          <p class="text-sm text-amber-700"><%= t('backupReminderMessagePrefix') %> <%= stats.backupReminderText %>. <%= t('backupReminderMessageSuffix') %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a class="btn-primary" href="/admin/backup"><%= t('backupNow') %></a>
          <a class="btn-outline" href="/admin/settings"><%= t('backupSettings') %></a>
        </div>
      </div>
    </div>
  <% } %>

  <div class="mt-6 metric-grid">
    <div class="metric-card metric-card-emphasis">
      <p class="metric-label"><%= t('totalVehicles') %></p>
      <p class="metric-value"><%= stats.vehicleCount %></p>
      <p class="metric-meta"><%= t('totalWorkers') %>: <%= stats.workerCount %> • <%= t('totalStaffs') %>: <%= stats.staffCount %></p>
    </div>
    <div class="metric-card">
      <p class="metric-label"><%= t('monthPaid') %></p>
      <p class="metric-value"><%= stats.monthCombined.paid %></p>
      <p class="metric-meta"><%= t('methodCash') %>: <%= stats.monthPaidByMethod?.cash || 0 %> • <%= t('methodBank') %>: <%= stats.monthPaidByMethod?.bank || 0 %> • <%= t('methodEWallet') %>: <%= stats.monthPaidByMethod?.eWallet || 0 %></p>
    </div>
    <div class="metric-card">
      <p class="metric-label"><%= t('customerCumulativeCreditsTitle') %></p>
      <p class="metric-value"><%= stats.outstandingCustomerCredit %></p>
      <p class="metric-meta"><%= t('customerOutstanding') %></p>
    </div>
    <div class="metric-card">
      <p class="metric-label"><%= t('vehicleCumulativeCreditsTitle') %></p>
      <p class="metric-value"><%= stats.outstandingVehicleCredit %></p>
      <p class="metric-meta"><%= t('exportsOutstanding') %></p>
    </div>
  </div>

  <div class="mt-6 grid gap-4 xl:grid-cols-[0.95fr_1.05fr]">
    <div class="dashboard-panel">
      <h2 class="dashboard-panel-title"><%= t('reports') %></h2>
      <p class="dashboard-panel-subtitle"><%= t('printExportSales') %></p>
      <div class="dashboard-mini-grid mt-4">
        <div class="metric-card">
          <p class="metric-label"><%= t('todayPaid') %></p>
          <p class="metric-value"><%= stats.todayExport.paid || 0 %></p>
          <p class="metric-meta"><%= t('todayCredit') %>: <%= stats.todayExport.credit || 0 %></p>
        </div>
        <div class="metric-card">
          <p class="metric-label"><%= t('monthSales') %></p>
          <p class="metric-value"><%= stats.monthSales || 0 %></p>
          <p class="metric-meta"><%= t('exportsTitle') %></p>
        </div>
        <div class="metric-card">
          <p class="metric-label"><%= t('backup') %></p>
          <p class="metric-value text-xl"><%= stats.backupOverdue ? t('backupReminderTitle') : t('backup') %></p>
          <p class="metric-meta"><%= backupText %></p>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        <a class="btn-outline" href="/admin/reports/summary"><%= t('summaryChart') %></a>
        <a class="btn-outline" href="/admin/reports/sales"><%= t('salesReport') %></a>
        <a class="btn-outline" href="/admin/reports/payroll-summary"><%= t('payrollSummaryTitle') %></a>
        <a class="btn-outline" href="/admin/backup"><%= t('backupDatabase') %></a>
      </div>
    </div>

    <div class="dashboard-panel">
      <h2 class="dashboard-panel-title"><%= t('officePulseTitle') %></h2>
      <p class="dashboard-panel-subtitle"><%= t('officePulseFinanceCopy') %></p>
      <div class="dashboard-mini-grid mt-4">
        <div class="metric-card">
          <p class="metric-label"><%= t('exportsTitle') %></p>
          <p class="metric-value"><%= stats.monthExport.paid %></p>
          <p class="metric-meta"><%= t('exportsOutstanding') %>: <%= stats.monthExport.credit %></p>
        </div>
        <div class="metric-card">
          <p class="metric-label"><%= t('customerPayments') %></p>
          <p class="metric-value"><%= stats.monthCustomer.paid %></p>
          <p class="metric-meta"><%= t('customerOutstanding') %>: <%= stats.monthCustomer.credit %></p>
        </div>
        <div class="metric-card">
          <p class="metric-label"><%= t('methodEWallet') %></p>
          <p class="metric-value"><%= stats.monthPaidByMethod?.eWallet || 0 %></p>
          <p class="metric-meta"><%= t('monthPaid') %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-8 grid gap-4 lg:grid-cols-2">
    <div class="card p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold"><%= t('topOutstandingCredits') %></h2>
        <a class="btn-outline" href="/records/credits"><%= t('viewAllCredits') %></a>
      </div>
      <div class="mt-4 overflow-x-auto">
        <table class="table-base text-sm">
          <thead class="table-head">
            <tr>
              <th class="px-4 py-3"><%= t('vehicleNumber') %></th>
              <th class="px-4 py-3"><%= t('customerName') %></th>
              <th class="px-4 py-3"><%= t('remainingAmount') %></th>
              <th class="px-4 py-3"><%= t('date') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (!topCredits || topCredits.length === 0) { %>
              <tr>
                <td class="px-4 py-4 text-slate-500" colspan="4"><%= t('noCredits') %></td>
              </tr>
            <% } %>
            <% topCredits.forEach((row) => { %>
              <tr class="table-row">
                <td class="px-4 py-3"><%= row.vehicle_number %></td>
                <td class="px-4 py-3"><%= row.customer_name %></td>
                <td class="px-4 py-3"><%= row.remaining_amount %></td>
                <td class="px-4 py-3"><%= row.credit_date %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="card p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold"><%= t('recentActivityTitle') %></h2>
        <a class="btn-outline" href="/admin/activity"><%= t('activityLogTitle') %></a>
      </div>
      <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200">
        <div class="overflow-x-auto">
          <table class="table-base text-sm">
            <thead class="table-head">
              <tr>
                <th class="px-4 py-3"><%= t('date') %></th>
                <th class="px-4 py-3"><%= t('user') %></th>
                <th class="px-4 py-3"><%= t('action') %></th>
                <th class="px-4 py-3"><%= t('entity') %></th>
                <th class="px-4 py-3"><%= t('details') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (!recentActivity || recentActivity.length === 0) { %>
                <tr>
                  <td class="px-4 py-4 text-slate-500" colspan="5"><%= t('noActivity') %></td>
                </tr>
              <% } %>
              <% recentActivity.forEach((row) => { %>
                <tr class="table-row">
                  <td class="px-4 py-3"><%= row.created_at %></td>
                  <td class="px-4 py-3 font-medium"><%= row.user_name || '-' %></td>
                  <td class="px-4 py-3"><%= row.actionLabel || row.action %></td>
                  <td class="px-4 py-3"><%= row.entityLabel || row.entity_type %></td>
                  <td class="px-4 py-3"><%= row.detailLabel || row.details || '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  (function () {
    var wrap = document.getElementById("snapshotRangeToggle");
    var form = document.getElementById("snapshotRangeForm");
    if (!wrap || !form) return;
    var calendarMode = String(document.documentElement.dataset.calendarMode || "AD").toUpperCase();
    var canConvertBs = document.documentElement.dataset.calendarAvailable === "1";
    var fromInput = form.querySelector('input[name="from"]');
    var toInput = form.querySelector('input[name="to"]');
    var rangeText = document.getElementById("snapshotRangeText");
    var buttons = Array.prototype.slice.call(wrap.querySelectorAll(".snapshot-range-btn"));
    var conversionCache = new Map();
    var rangeRenderToken = 0;

    async function convertAdToBsMany(values) {
      var unique = Array.from(new Set((values || [])
        .map(function (value) { return String(value || "").trim(); })
        .filter(function (value) { return value.length > 0; })
      ));
      if (!unique.length) return {};

      var result = {};
      var missing = [];
      unique.forEach(function (value) {
        if (conversionCache.has(value)) {
          result[value] = conversionCache.get(value);
        } else {
          missing.push(value);
        }
      });
      if (!missing.length) return result;

      try {
        var response = await fetch("/calendar/convert", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ direction: "ad_to_bs", values: missing })
        });
        if (response.ok) {
          var payload = await response.json();
          var converted = payload && payload.converted ? payload.converted : {};
          missing.forEach(function (value) {
            var mapped = Object.prototype.hasOwnProperty.call(converted, value) ? converted[value] : null;
            conversionCache.set(value, mapped);
            result[value] = mapped;
          });
          return result;
        }
      } catch (err) {
        // ignore network/conversion errors and fall back to AD text
      }

      missing.forEach(function (value) {
        conversionCache.set(value, null);
        result[value] = null;
      });
      return result;
    }

    async function renderRangeText() {
      if (!rangeText) return;
      var fromValue = String(fromInput.value || "").trim();
      var toValue = String(toInput.value || "").trim();
      var myToken = ++rangeRenderToken;

      if (calendarMode === "BS" && canConvertBs) {
        var mapped = await convertAdToBsMany([fromValue, toValue]);
        if (myToken !== rangeRenderToken) return;
        var fromText = mapped[fromValue] || fromValue;
        var toText = mapped[toValue] || toValue;
        rangeText.textContent = fromText + " → " + toText;
        rangeText.title = "AD: " + fromValue + " → " + toValue;
        return;
      }

      rangeText.textContent = fromValue + " → " + toValue;
      rangeText.title = "";
    }

    function setActive(button) {
      if (!button) return;
      buttons.forEach(function (btn) {
        var active = btn === button;
        btn.setAttribute("aria-pressed", active ? "true" : "false");
        btn.classList.toggle("is-active", active);
      });
      fromInput.value = button.getAttribute("data-from") || "";
      toInput.value = button.getAttribute("data-to") || "";
      void renderRangeText();
    }

    wrap.addEventListener("click", function (event) {
      var button = event.target.closest(".snapshot-range-btn");
      if (!button) return;
      setActive(button);
    });

    var defaultButton = wrap.querySelector("[data-default-selected]") || buttons[0];
    setActive(defaultButton);
  })();
</script>
<%- include('../partials/shell-end') %>
