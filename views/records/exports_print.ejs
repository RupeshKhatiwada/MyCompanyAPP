<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('exportsTitle') %> | AQUA MSK</title>
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
  <style>
    <%- include('../partials/print-report-styles', { pageSize: 'A4 landscape' }) %>
  </style>
</head>
<body class="text-slate-900">
  <div class="print-page">
    <div class="print-toolbar print-hidden">
      <button class="btn-primary" onclick="window.print()"><%= t('print') %></button>
    </div>

    <div class="print-header">
      <div class="print-header-copy">
        <%- include('../partials/print-brand', { subtitle: t('exportsTitle') }) %>
        <div class="print-header-meta">
          <span><strong><%= t('from') %>:</strong> <%= typeof formatDateDual === 'function' ? formatDateDual(from) : from %></span>
          <span><strong><%= t('to') %>:</strong> <%= typeof formatDateDual === 'function' ? formatDateDual(to) : to %></span>
          <% if (q) { %>
            <span><strong><%= t('search') %>:</strong> <%= q %></span>
          <% } %>
        </div>
      </div>
    </div>

    <div class="print-section mt-6">
      <div class="print-section-header">
        <div>
          <h2 class="print-section-title"><%= t('exportsTitle') %></h2>
          <p class="print-section-subtitle"><%= t('tripWorkspaceSubtitle') %></p>
        </div>
      </div>
      <div class="print-table-wrap">
        <table class="print-table">
          <thead class="table-head">
            <tr>
              <th><%= t('date') %></th>
              <th><%= t('receiptNo') %></th>
              <th><%= t('vehicle') %></th>
              <th><%= t('jars') %></th>
              <th><%= t('returnJars') %></th>
              <th><%= t('leakageJars') %></th>
              <th><%= t('netJars') %></th>
              <th><%= t('soldJars') %></th>
              <th><%= t('soldJarAmount') %></th>
              <th><%= t('bottleCases') %></th>
              <th><%= t('dispensers') %></th>
              <th><%= t('returnBottleCases') %></th>
              <th><%= t('damagedBottleCases') %></th>
              <th><%= t('netBottles') %></th>
              <th><%= t('totalExportAmount') %></th>
              <th><%= t('collectionAmount') %></th>
              <th><%= t('netCollectionAmount') %></th>
              <th><%= t('paidAmount') %></th>
              <th><%= t('creditAmount') %></th>
              <th><%= t('recordedBy') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (exportsRows.length === 0) { %>
              <tr>
                <td class="text-slate-500" colspan="20"><%= t('noExports') %></td>
              </tr>
            <% } %>
            <% exportsRows.forEach((record) => { %>
              <% const netJars = Math.max(0, (record.jar_count || 0) - (record.return_jar_count || 0) - (record.leakage_jar_count || 0)); %>
              <% const netBottles = Math.max(0, (record.bottle_case_count || 0) - (record.return_bottle_case_count || 0) - (record.damaged_bottle_case_count || 0)); %>
              <% const soldJarAmount = Number(record.sold_jar_amount || 0) || (Number(record.sold_jar_count || 0) * Number(record.sold_jar_price || 0)); %>
              <% const collectionAmount = Number(record.is_company || 0) === 1 ? Number(record.collection_amount || 0) + soldJarAmount : Number(record.collection_amount || 0); %>
              <% const expenseAmount = Number(record.expense_amount || 0); %>
              <% const paidAmount = Number(record.is_company || 0) === 1 ? Math.max(Number(record.paid_amount || 0), collectionAmount) : Number(record.paid_amount || 0); %>
              <% const creditAmount = Number(record.credit_amount || 0); %>
              <% const totalAmount = Number(record.is_company || 0) === 1 ? Math.max(Number(record.total_amount || 0), collectionAmount) : Number(record.total_amount || 0); %>
              <% const netCollectionAmount = Math.max(0, collectionAmount - expenseAmount); %>
              <tr>
                <td><%= typeof formatDateDual === 'function' ? formatDateDual(record.export_date) : record.export_date %></td>
                <td><%= record.receipt_no || (`#${record.id}`) %></td>
                <td><strong><%= `${record.owner_name} • ${record.vehicle_number}` %></strong></td>
                <td><%= record.jar_count %></td>
                <td><%= record.return_jar_count %></td>
                <td><%= record.leakage_jar_count %></td>
                <td><%= netJars %></td>
                <td><%= record.sold_jar_count || 0 %></td>
                <td><%= record.sold_jar_amount || 0 %></td>
                <td><%= record.bottle_case_count %></td>
                <td><%= record.dispenser_count || 0 %></td>
                <td><%= record.return_bottle_case_count %></td>
                <td><%= record.damaged_bottle_case_count || 0 %></td>
                <td><%= netBottles %></td>
                <td><%= totalAmount %></td>
                <td><%= collectionAmount %></td>
                <td><%= netCollectionAmount %></td>
                <td><%= paidAmount %></td>
                <td><%= creditAmount %></td>
                <td><%= record.recorded_by || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="print-summary-grid mt-6">
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('tripCount') %></p>
        <p class="print-summary-value"><%= exportTotals.total_trips %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalJars') %></p>
        <p class="print-summary-value"><%= exportTotals.total_jars %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalBottleCases') %></p>
        <p class="print-summary-value"><%= exportTotals.total_bottle_cases %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalDispensers') %></p>
        <p class="print-summary-value"><%= exportTotals.total_dispensers || 0 %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalReturnJars') %></p>
        <p class="print-summary-value"><%= exportTotals.total_return_jars %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalReturnBottleCases') %></p>
        <p class="print-summary-value"><%= exportTotals.total_return_bottles %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalLeakageJars') %></p>
        <p class="print-summary-value"><%= exportTotals.total_leakage_jars %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalSoldJars') %></p>
        <p class="print-summary-value"><%= exportTotals.total_sold_jars %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalSoldJarAmount') %></p>
        <p class="print-summary-value"><%= exportTotals.total_sold_jar_amount %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('netJars') %></p>
        <p class="print-summary-value"><%= Math.max(0, exportTotals.total_jars - exportTotals.total_return_jars - exportTotals.total_leakage_jars) %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('netBottles') %></p>
        <p class="print-summary-value"><%= Math.max(0, exportTotals.total_bottle_cases - exportTotals.total_return_bottles) %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalExportAmount') %></p>
        <p class="print-summary-value"><%= exportTotals.total_amount %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalCollectionAmount') %></p>
        <p class="print-summary-value"><%= collectionSummary.totalAmountCollected %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('collectionDeductions') %></p>
        <p class="print-summary-value"><%= collectionSummary.totalDeductions %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('netCollectionAmount') %></p>
        <p class="print-summary-value"><%= collectionSummary.netCollectionAmount %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalPaidAmount') %></p>
        <p class="print-summary-value"><%= exportTotals.total_paid %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalCreditAmount') %></p>
        <p class="print-summary-value"><%= exportTotals.total_credit %></p>
      </div>
    </div>
  </div>
</body>
</html>
