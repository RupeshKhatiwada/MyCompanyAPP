<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('exportPaymentHistoryTitle') %> | AQUA MSK</title>
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
  <style>
    @media print {
      @page {
        size: A4 portrait;
        margin: 10mm;
      }
      .print-hidden { display: none !important; }
      .print-sheet {
        max-width: none !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .print-table {
        width: 100% !important;
        font-size: 10px !important;
      }
      .print-table thead {
        display: table-header-group !important;
      }
      .print-table th,
      .print-table td {
        padding: 4px 6px !important;
        vertical-align: top;
      }
      .print-table tr {
        break-inside: avoid;
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body class="bg-white text-slate-900">
  <div class="print-sheet mx-auto max-w-6xl p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1">
        <%- include('../partials/print-brand', { subtitle: t('exportPaymentHistoryTitle') }) %>
        <p class="mt-2 text-sm text-slate-600">
          <strong><%= t('vehicle') %>:</strong> <%= `${vehicle.owner_name} • ${vehicle.vehicle_number}` %>
        </p>
        <p class="text-sm text-slate-600">
          <strong><%= t('from') %>:</strong> <%= typeof formatDateDual === 'function' ? formatDateDual(from) : from %>
          <span class="mx-2">•</span>
          <strong><%= t('to') %>:</strong> <%= typeof formatDateDual === 'function' ? formatDateDual(to) : to %>
          <span class="mx-2">•</span>
          <strong><%= t('dateTime') %>:</strong> <%= printedAt %>
        </p>
      </div>
      <button class="btn-primary print-hidden" onclick="window.print()"><%= t('print') %></button>
    </div>

    <div class="mt-6 grid gap-3 text-sm sm:grid-cols-2">
      <div class="card p-4">
        <p class="text-slate-500"><%= t('entries') %></p>
        <p class="text-lg font-semibold"><%= (payments || []).length %></p>
      </div>
      <div class="card p-4">
        <p class="text-slate-500"><%= t('totalPaidAmount') %></p>
        <p class="text-lg font-semibold"><%= totalPaid %></p>
      </div>
    </div>

    <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200">
      <table class="table-base print-table">
        <thead class="table-head">
          <tr>
            <th class="px-4 py-3"><%= t('dateTime') %></th>
            <th class="px-4 py-3"><%= t('date') %></th>
            <th class="px-4 py-3"><%= t('receiptNo') %></th>
            <th class="px-4 py-3"><%= t('paymentReceiptNo') %></th>
            <th class="px-4 py-3"><%= t('paymentSource') %></th>
            <th class="px-4 py-3"><%= t('paymentMethodLabel') %></th>
            <th class="px-4 py-3"><%= t('amount') %></th>
            <th class="px-4 py-3"><%= t('summary') %></th>
          </tr>
        </thead>
        <tbody>
          <% if (!payments || payments.length === 0) { %>
            <tr>
              <td class="px-4 py-4 text-slate-500" colspan="8"><%= t('noPaymentHistory') %></td>
            </tr>
          <% } %>
          <% (payments || []).forEach((row) => { %>
            <% const methodLabel = row.payment_method === 'BANK' ? t('methodBank') : row.payment_method === 'E_WALLET' ? t('methodEWallet') : row.payment_method === 'MIXED' ? t('methodMixed') : t('methodCash'); %>
            <tr class="table-row">
              <td class="px-4 py-3"><%= row.created_at %></td>
              <td class="px-4 py-3"><%= typeof formatDateDual === 'function' ? formatDateDual(row.export_date) : row.export_date %></td>
              <td class="px-4 py-3"><%= row.receipt_no %></td>
              <td class="px-4 py-3"><%= row.payment_receipt_no || '-' %></td>
              <td class="px-4 py-3"><%= row.source === 'day' ? t('paymentSourceDay') : t('paymentSourceTrip') %></td>
              <td class="px-4 py-3"><%= methodLabel %></td>
              <td class="px-4 py-3"><%= row.payment_amount %></td>
              <td class="px-4 py-3"><%= row.summary || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% if (autoPrint) { %>
    <script>
      window.addEventListener('load', function () {
        window.print();
      });
    </script>
  <% } %>
</body>
</html>
