<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('exportPaymentHistoryTitle') %> | AQUA MSK</title>
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
  <style>
    <%- include('../partials/print-report-styles', { pageSize: 'A4 portrait' }) %>
  </style>
</head>
<body class="text-slate-900">
  <div class="print-page">
    <div class="print-toolbar print-hidden">
      <button class="btn-primary" onclick="window.print()"><%= t('print') %></button>
    </div>

    <div class="print-header">
      <div class="print-header-copy">
        <%- include('../partials/print-brand', { subtitle: t('exportPaymentHistoryTitle') }) %>
        <div class="print-header-meta">
          <span><strong><%= t('vehicle') %>:</strong> <%= `${vehicle.owner_name} • ${vehicle.vehicle_number}` %></span>
          <span><strong><%= t('from') %>:</strong> <%= typeof formatDateDual === 'function' ? formatDateDual(from) : from %></span>
          <span><strong><%= t('to') %>:</strong> <%= typeof formatDateDual === 'function' ? formatDateDual(to) : to %></span>
          <span><strong><%= t('dateTime') %>:</strong> <%= printedAt %></span>
        </div>
      </div>
    </div>

    <div class="print-summary-grid mt-6">
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('entries') %></p>
        <p class="print-summary-value"><%= (payments || []).length %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalPaidAmount') %></p>
        <p class="print-summary-value"><%= totalPaid %></p>
      </div>
    </div>

    <div class="print-section mt-6">
      <div class="print-section-header">
        <div>
          <h2 class="print-section-title"><%= t('paymentHistoryTitle') %></h2>
          <p class="print-section-subtitle"><%= t('exportPaymentHistorySubtitle') %></p>
        </div>
      </div>
      <div class="print-table-wrap">
        <table class="print-table">
        <thead class="table-head">
          <tr>
            <th><%= t('dateTime') %></th>
            <th><%= t('date') %></th>
            <th><%= t('receiptNo') %></th>
            <th><%= t('paymentReceiptNo') %></th>
            <th><%= t('paymentSource') %></th>
            <th><%= t('paymentMethodLabel') %></th>
            <th><%= t('amount') %></th>
            <th><%= t('summary') %></th>
          </tr>
        </thead>
        <tbody>
          <% if (!payments || payments.length === 0) { %>
            <tr>
              <td class="text-slate-500" colspan="8"><%= t('noPaymentHistory') %></td>
            </tr>
          <% } %>
          <% (payments || []).forEach((row) => { %>
            <% const methodLabel = row.payment_method === 'BANK' ? t('methodBank') : row.payment_method === 'E_WALLET' ? t('methodEWallet') : row.payment_method === 'MIXED' ? t('methodMixed') : t('methodCash'); %>
            <% const sourceLabel = row.source_label_key ? t(row.source_label_key) : row.source === 'day' ? t('paymentSourceDay') : t('paymentSourceTrip'); %>
            <tr>
              <td><%= row.created_at %></td>
              <td><%= typeof formatDateDual === 'function' ? formatDateDual(row.export_date) : row.export_date %></td>
              <td><%= row.receipt_no %></td>
              <td><%= row.payment_receipt_no || '-' %></td>
              <td><%= sourceLabel %></td>
              <td><%= methodLabel %></td>
              <td><%= row.payment_amount %></td>
              <td><%= row.summary || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
        </table>
      </div>
    </div>
  </div>
  <% if (autoPrint) { %>
    <script>
      window.addEventListener('load', function () {
        window.print();
      });
    </script>
  <% } %>
</body>
</html>
