          <p class="text-slate-500"><%= t('tripCount') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_trips %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('totalJars') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_jars %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('totalBottleCases') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_bottle_cases %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('totalDispensers') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_dispensers || 0 %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('totalReturnJars') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_return_jars %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('totalReturnBottleCases') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_return_bottles %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('totalLeakageJars') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_leakage_jars %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('totalSoldJars') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_sold_jars %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('totalSoldJarAmount') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_sold_jar_amount %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('netJars') %></p>
          <p class="mt-2 text-lg font-semibold"><%= Math.max(0, exportTotals.total_jars - exportTotals.total_return_jars - exportTotals.total_leakage_jars) %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('netBottles') %></p>
          <p class="mt-2 text-lg font-semibold"><%= Math.max(0, exportTotals.total_bottle_cases - exportTotals.total_return_bottles - (exportTotals.total_damaged_bottles || 0)) %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('damagedBottleCases') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_damaged_bottles || 0 %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('totalExportAmount') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_amount %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('totalPaidAmount') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_paid %></p>
          <p class="mt-1 text-xs text-slate-500"><%= t('methodCash') %>: <%= Number(rangePaidByMethod?.cash_paid || 0) %> • <%= t('methodBank') %>: <%= Number(rangePaidByMethod?.bank_paid || 0) %> • <%= t('methodEWallet') %>: <%= Number(rangePaidByMethod?.ewallet_paid || 0) %></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-slate-500"><%= t('totalCreditAmount') %></p>
          <p class="mt-2 text-lg font-semibold"><%= exportTotals.total_credit %></p>
        </div>
      </div>
    </details>
  </div>
  </div>
</section>

<script>
  (() => {
    const buttons = Array.from(document.querySelectorAll('[data-export-view]'));
    const sections = Array.from(document.querySelectorAll('[data-export-panel]'));
    if (!buttons.length || !sections.length) return;

    const setView = (view) => {
      buttons.forEach((button) => {
        button.classList.toggle('is-active', button.dataset.exportView === view);
      });
      sections.forEach((section) => {
        section.classList.toggle('hidden', section.dataset.exportPanel !== view);
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => setView(button.dataset.exportView || 'trips'));
    });

    setView('trips');
  })();

  (() => {
    const panels = Array.from(document.querySelectorAll('details[data-accordion="export-totals"]'));
    panels.forEach((panel) => {
      panel.addEventListener('toggle', () => {
        if (!panel.open) return;
        panels.forEach((other) => {
          if (other !== panel) other.removeAttribute('open');
        });
      });
    });
  })();

  (() => {
    const forms = Array.from(document.querySelectorAll('form.js-payment-split'));
    const toSafe = (value) => {
      const num = Number(value || 0);
      if (Number.isNaN(num) || num < 0) return 0;
      return num;
    };
    const formatMoney = (value) => {
      const safe = Math.round(toSafe(value) * 100) / 100;
      return safe > 0 ? String(safe) : '';
    };
    forms.forEach((form) => {
      const cashInput = form.querySelector("input[name='cash_amount']");
      const bankInput = form.querySelector("input[name='bank_amount']");
      const walletInput = form.querySelector("input[name='ewallet_amount']");
      const totalInput = form.querySelector("input[name='payment_amount']");
      if (!cashInput || !bankInput || !walletInput || !totalInput) return;
      const maxRaw = Number(form.dataset.max || cashInput.getAttribute('max') || '0');
      const maxValue = Number.isNaN(maxRaw) ? 0 : Math.max(0, maxRaw);
      const recalc = () => {
        let cash = toSafe(cashInput.value);
        let bank = toSafe(bankInput.value);
        let wallet = toSafe(walletInput.value);
        let remaining = maxValue;
        const clamp = (amount) => {
          const use = Math.min(amount, remaining);
          remaining -= use;
          return use;
        };
        cash = clamp(cash);
        bank = clamp(bank);
        wallet = clamp(wallet);
        cashInput.value = formatMoney(cash);
        bankInput.value = formatMoney(bank);
        walletInput.value = formatMoney(wallet);
        totalInput.value = formatMoney(cash + bank + wallet);
      };
      [cashInput, bankInput, walletInput].forEach((input) => input.addEventListener('input', recalc));
      recalc();
    });
  })();
</script>
<%- include('../partials/shell-end') %>
