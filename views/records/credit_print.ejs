<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('creditsTitle') %> | AQUA MSK</title>
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
  <style>
    <%- include('../partials/print-receipt-styles') %>
  </style>
</head>
<body class="text-slate-900">
  <% const toNumber = (value) => Number(value || 0); %>
  <% const creditJars = toNumber(record.credit_jars); %>
  <% const creditBottleCases = toNumber(record.credit_bottle_cases); %>
  <% const creditDispensers = toNumber(record.credit_dispensers); %>
  <% const creditJarContainers = toNumber(record.credit_jar_containers); %>
  <% const jarPrice = toNumber(record.jar_price); %>
  <% const bottleCasePrice = toNumber(record.bottle_case_price); %>
  <% const dispenserPrice = toNumber(record.dispenser_price); %>
  <% const jarContainerPrice = toNumber(record.jar_container_price); %>
  <% const amount = toNumber(record.amount); %>
  <% const paidAmount = toNumber(record.paid_amount); %>
  <% const remainingAmount = Math.max(0, amount - paidAmount); %>
  <% const isPaid = paidAmount >= amount && amount > 0; %>
  <% const isPartial = !isPaid && paidAmount > 0; %>
  <% const statusLabel = isPaid ? t('paid') : (isPartial ? t('statusPartial') : t('unpaid')); %>
  <% const itemLines = []; %>
  <% if (creditJars > 0) { %>
    <% itemLines.push({ label: t('creditJars'), qty: creditJars, unitPrice: jarPrice, amount: creditJars * jarPrice }); %>
  <% } %>
  <% if (creditBottleCases > 0) { %>
    <% itemLines.push({ label: t('creditBottleCases'), qty: creditBottleCases, unitPrice: bottleCasePrice, amount: creditBottleCases * bottleCasePrice }); %>
  <% } %>
  <% if (creditDispensers > 0) { %>
    <% itemLines.push({ label: t('creditDispensers'), qty: creditDispensers, unitPrice: dispenserPrice, amount: creditDispensers * dispenserPrice }); %>
  <% } %>
  <% if (creditJarContainers > 0) { %>
    <% itemLines.push({ label: t('creditJarContainers'), qty: creditJarContainers, unitPrice: jarContainerPrice, amount: creditJarContainers * jarContainerPrice }); %>
  <% } %>

  <div class="receipt-page">
    <div class="receipt-topbar print-hidden">
      <button class="btn-primary" onclick="window.print()"><%= t('print') %></button>
    </div>

    <div class="receipt-card">
      <%- include('../partials/print-brand', { subtitle: t('creditsTitle') }) %>

      <div class="receipt-chip-row">
        <span class="receipt-chip <%= isPaid ? 'is-paid' : (isPartial ? 'is-partial' : 'is-unpaid') %>"><%= t('status') %>: <%= statusLabel %></span>
        <% if (record.trip_receipt_no) { %>
          <span class="receipt-chip"><%= t('linkedTrip') %>: <%= record.trip_receipt_no %></span>
        <% } %>
      </div>

      <div class="receipt-meta-grid">
        <div>
          <p class="receipt-meta-label"><%= t('receiptNo') %></p>
          <p class="receipt-meta-value"><%= record.receipt_no || (`#${record.id}`) %></p>
        </div>
        <div>
          <p class="receipt-meta-label"><%= t('creditDate') %></p>
          <p class="receipt-meta-value"><%= typeof formatDateDual === 'function' ? formatDateDual(record.credit_date) : record.credit_date %></p>
        </div>
        <div>
          <p class="receipt-meta-label"><%= t('vehicleNumber') %></p>
          <p class="receipt-meta-value"><%= `${record.owner_name} • ${record.vehicle_number}` %></p>
        </div>
        <div>
          <p class="receipt-meta-label"><%= t('customerName') %></p>
          <p class="receipt-meta-value"><%= record.customer_name %></p>
        </div>
        <% if (record.customer_phone) { %>
          <div>
            <p class="receipt-meta-label"><%= t('customerPhone') %></p>
            <p class="receipt-meta-value"><%= record.customer_phone %></p>
          </div>
        <% } %>
        <% if (record.customer_location) { %>
          <div>
            <p class="receipt-meta-label"><%= t('customerLocation') %></p>
            <p class="receipt-meta-value"><%= record.customer_location %></p>
          </div>
        <% } %>
        <% if (record.trip_receipt_no) { %>
          <div>
            <p class="receipt-meta-label"><%= t('linkedTrip') %></p>
            <p class="receipt-meta-value"><%= record.trip_receipt_no %></p>
          </div>
        <% } %>
        <% if (record.trip_date) { %>
          <div>
            <p class="receipt-meta-label"><%= t('tripDate') %></p>
            <p class="receipt-meta-value"><%= typeof formatDateDual === 'function' ? formatDateDual(record.trip_date) : record.trip_date %></p>
          </div>
        <% } %>
      </div>

      <div class="receipt-divider"></div>

      <p class="receipt-section-title"><%= t('allItems') %></p>
      <% if (itemLines.length === 0) { %>
        <p class="mt-2 text-xs text-slate-500"><%= t('noData') %></p>
      <% } else { %>
        <div class="mt-1">
          <div class="receipt-line-head">
            <span><%= t('allItems') %></span>
            <span><%= t('quantity') %></span>
            <span><%= t('amount') %></span>
          </div>
          <% itemLines.forEach((item) => { %>
            <div class="receipt-line">
              <div>
                <p class="receipt-line-name"><%= item.label %></p>
                <% if (item.unitPrice > 0) { %>
                  <p class="receipt-line-sub"><%= t('unit') %>: <%= item.unitPrice %></p>
                <% } %>
              </div>
              <p class="receipt-line-value"><%= item.qty %></p>
              <p class="receipt-line-value"><%= item.amount > 0 ? item.amount : '-' %></p>
            </div>
          <% }) %>
        </div>
      <% } %>

      <div class="receipt-divider"></div>

      <div class="receipt-totals">
        <div class="row">
          <span><%= t('amount') %></span>
          <strong><%= amount %></strong>
        </div>
        <div class="row">
          <span><%= t('paidAmount') %></span>
          <strong><%= paidAmount %></strong>
        </div>
        <div class="row">
          <span><%= t('remainingAmount') %></span>
          <strong><%= remainingAmount %></strong>
        </div>
        <div class="row final">
          <span><%= t('status') %></span>
          <strong><%= statusLabel %></strong>
        </div>
      </div>

      <% if (record.note) { %>
        <div class="receipt-note">
          <strong><%= t('note') %>:</strong> <%= record.note %>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
