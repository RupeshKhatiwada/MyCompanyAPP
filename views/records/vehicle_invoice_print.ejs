<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('vehicleInvoiceTitle') %> | AQUA MSK</title>
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
  <style>
    <%- include('../partials/print-report-styles', { pageSize: 'A4 portrait' }) %>
  </style>
</head>
<body class="text-slate-900">
  <div class="print-page">
    <div class="print-toolbar print-hidden">
      <button class="btn-primary" onclick="window.print()"><%= t('print') %></button>
    </div>

    <div class="print-header">
      <div class="print-header-copy">
        <%- include('../partials/print-brand', { subtitle: t('vehicleInvoiceTitle') }) %>
        <div class="print-header-meta">
          <span><strong><%= t('vehicle') %>:</strong> <%= `${vehicle.vehicle_number} • ${vehicle.owner_name}` %></span>
          <span><strong><%= t('from') %>:</strong> <%= typeof formatDateDual === 'function' ? formatDateDual(from) : from %></span>
          <span><strong><%= t('to') %>:</strong> <%= typeof formatDateDual === 'function' ? formatDateDual(to) : to %></span>
          <% if (invoiceNo) { %>
            <span><strong><%= t('invoiceNo') %>:</strong> <%= invoiceNo %></span>
          <% } %>
        </div>
      </div>
    </div>

    <div class="print-summary-grid mt-6">
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('tripCount') %></p>
        <p class="print-summary-value"><%= totals.total_trips %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalJars') %></p>
        <p class="print-summary-value"><%= totals.total_jars %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('netJars') %></p>
        <p class="print-summary-value"><%= totals.total_net_jars %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalAmount') %></p>
        <p class="print-summary-value"><%= totals.total_amount %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalPaidAmount') %></p>
        <p class="print-summary-value"><%= totals.total_paid %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('totalRemaining') %></p>
        <p class="print-summary-value"><%= totals.total_remaining %></p>
      </div>
      <div class="print-summary-card">
        <p class="print-summary-label"><%= t('savingsTitle') %></p>
        <p class="print-summary-value"><%= totals.total_savings || 0 %></p>
      </div>
    </div>

    <div class="print-section mt-6">
      <div class="print-section-header">
        <div>
          <h2 class="print-section-title"><%= t('exportsTitle') %></h2>
          <p class="print-section-subtitle"><%= t('exportSummaryTitle') %></p>
        </div>
      </div>
      <div class="print-table-wrap">
        <table class="print-table">
        <thead class="table-head">
          <tr>
            <th><%= t('date') %></th>
            <th><%= t('receiptNo') %></th>
            <th><%= t('jarCount') %></th>
            <th><%= t('netJars') %></th>
            <th><%= t('amount') %></th>
            <th><%= t('paidAmount') %></th>
            <th><%= t('remainingAmount') %></th>
          </tr>
        </thead>
        <tbody>
          <% if (!rows || rows.length === 0) { %>
            <tr>
              <td class="text-slate-500" colspan="7"><%= t('noExports') %></td>
            </tr>
          <% } %>
          <% (rows || []).forEach((row) => { %>
            <tr>
              <td><%= typeof formatDateDual === 'function' ? formatDateDual(row.export_date) : row.export_date %></td>
              <td><%= row.receipt_no || (`#${row.id}`) %></td>
              <td><%= row.jar_count || 0 %></td>
              <td><%= row.net_jars || 0 %></td>
              <td><%= row.total_amount || 0 %></td>
              <td><%= row.paid_amount || 0 %></td>
              <td><%= row.remaining_amount || 0 %></td>
            </tr>
          <% }) %>
        </tbody>
        </table>
      </div>
    </div>

    <div class="print-section mt-6">
      <div class="print-section-header">
        <div>
          <h2 class="print-section-title"><%= t('savingsByDateTitle') %></h2>
          <p class="print-section-subtitle"><%= t('partnerSavingsInvoiceSubtitle') %></p>
        </div>
      </div>
      <div class="print-table-wrap">
        <table class="print-table">
        <thead class="table-head">
          <tr>
            <th><%= t('date') %></th>
            <th><%= t('savingsTitle') %></th>
            <th><%= t('note') %></th>
          </tr>
        </thead>
        <tbody>
          <% if (!(savingsRows || []).length) { %>
            <tr>
              <td class="text-slate-500" colspan="3"><%= t('noSavingsRows') %></td>
            </tr>
          <% } %>
          <% (savingsRows || []).forEach((row) => { %>
            <tr>
              <td><%= typeof formatDateDual === 'function' ? formatDateDual(row.entry_date) : row.entry_date %></td>
              <td><%= row.savings_amount || 0 %></td>
              <td><%= row.notes || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
        </table>
      </div>
    </div>
  </div>
  <% if (autoPrint) { %>
    <script>
      window.addEventListener('load', function () {
        window.print();
      });
    </script>
  <% } %>
</body>
</html>
