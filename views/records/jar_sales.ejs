<%- include('../partials/shell-start', { title }) %>
<section class="py-8">
  <%
    const safeOpenJarSaleCredits = typeof openJarSaleCredits !== 'undefined' ? openJarSaleCredits : [];
    const safeOpenJarSaleCreditSummary = typeof openJarSaleCreditSummary !== 'undefined'
      ? openJarSaleCreditSummary
      : { entry_count: 0, total_amount: 0, paid_amount: 0, remaining_amount: 0 };
    const safeOpenJarSaleCreditAllTime = typeof openJarSaleCreditAllTime !== 'undefined' ? Number(openJarSaleCreditAllTime || 0) : 0;
    const salesRows = rows || [];
  %>

  <div class="page-header">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold"><%= t('jarSalesTitle') %></h1>
        <p class="mt-1 text-slate-600"><%= t('jarSalesSubtitle') %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn-outline" href="/records/payment-history?from=<%= from %>&to=<%= to %>&source=JAR_SALE"><%= t('paymentHistoryTitle') %></a>
        <a class="btn-outline" href="/records/jar-sales/export?from=<%= from %>&to=<%= to %>&q=<%= encodeURIComponent(q || '') %>"><%= t('exportCsv') %></a>
        <a class="btn-primary" href="/records/jar-sales/new"><%= t('addJarSaleTitle') %></a>
      </div>
    </div>
  </div>

  <% if (error) { %>
    <div class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= success %></div>
  <% } %>

  <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('totalAmount') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= totals.total %></p>
      <p class="mt-1 text-xs text-slate-500"><%= from %> -> <%= to %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('paidAmount') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= totals.paid %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t('entries') %>: <%= salesRows.length %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('totalRemaining') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= totals.credit %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t('allTimeTotalCredits') %>: <%= safeOpenJarSaleCreditAllTime %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('quantity') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= totals.qty %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t('openCredits') %>: <%= safeOpenJarSaleCreditSummary.entry_count %></p>
    </div>
  </div>

  <div class="mt-6 card p-5">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="surface-muted px-4 py-3 text-sm text-slate-600">
        <div><span class="font-medium text-slate-800"><%= t('selectedRange') %>:</span> <%= from %> -> <%= to %></div>
        <div class="mt-1"><span class="font-medium text-slate-800"><%= t('entries') %>:</span> <%= salesRows.length %></div>
        <div class="mt-1"><span class="font-medium text-slate-800"><%= t('search') %>:</span> <%= q || '-' %></div>
      </div>
      <div class="flex flex-wrap gap-2 text-sm">
        <a class="btn-outline" href="/records/jar-sales?from=<%= today %>&to=<%= today %>&q=<%= encodeURIComponent(q || '') %>"><%= t('presetToday') %></a>
        <a class="btn-outline" href="/records/jar-sales?from=<%= monthStart %>&to=<%= today %>&q=<%= encodeURIComponent(q || '') %>"><%= t('presetThisMonth') %></a>
        <a class="btn-outline" href="/records/jar-sales?from=<%= yearStart %>&to=<%= today %>&q=<%= encodeURIComponent(q || '') %>"><%= t('presetThisYear') %></a>
      </div>
    </div>

    <form class="mt-5 grid gap-3 lg:grid-cols-5" method="get" action="/records/jar-sales">
      <div>
        <label class="label"><%= t('from') %></label>
        <input class="input mt-1" type="date" name="from" value="<%= from %>" />
      </div>
      <div>
        <label class="label"><%= t('to') %></label>
        <input class="input mt-1" type="date" name="to" value="<%= to %>" />
      </div>
      <div class="lg:col-span-2">
        <label class="label"><%= t('search') %></label>
        <input class="input mt-1" type="text" name="q" value="<%= q || '' %>" placeholder="<%= t('searchPlaceholder') %>" />
      </div>
      <div class="flex items-end">
        <button class="btn-outline w-full" type="submit"><%= t('filter') %></button>
      </div>
    </form>
  </div>

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.55fr)_minmax(320px,0.95fr)]">
    <div class="card p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold"><%= t('jarSalesTitle') %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= t('jarSalesSubtitle') %></p>
        </div>
        <div class="text-sm text-slate-500"><%= from %> -> <%= to %></div>
      </div>

      <% if (!salesRows.length) { %>
        <div class="empty-state mt-4">
          <p class="empty-state-title"><%= t('noData') %></p>
          <p class="empty-state-copy"><%= t('emptyRangeHint') %></p>
        </div>
      <% } else { %>
        <div class="mt-4 space-y-3">
          <% salesRows.forEach((row) => { %>
            <%
              const vehicleNo = row.vehicle_number_ref || row.vehicle_number || '-';
              const vehicleLabel = row.owner_name ? `${row.owner_name} • ${vehicleNo}` : vehicleNo;
              const isPaid = Number(row.remaining_amount || 0) <= 0;
              const isPartial = !isPaid && Number(row.paid_amount || 0) > 0;
              const statusLabel = isPaid ? t('paid') : (isPartial ? t('statusPartial') : t('unpaid'));
              const statusClass = isPaid ? 'status-pill-paid' : (isPartial ? 'status-pill-partial' : 'status-pill-unpaid');
            %>
            <div class="record-card">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="font-semibold text-slate-900"><%= row.customer_name || '-' %></p>
                    <span class="status-pill <%= statusClass %>"><%= statusLabel %></span>
                    <% if (row.is_company) { %>
                      <span class="status-pill status-pill-company"><%= t('companyVehicle') %></span>
                    <% } %>
                  </div>
                  <p class="mt-1 text-xs text-slate-500"><%= row.sale_date %> • <%= row.jar_name %></p>
                  <p class="mt-2 text-sm text-slate-600"><%= vehicleLabel %></p>
                </div>
                <div class="surface-muted min-w-[190px] px-4 py-3 text-right">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('remainingAmount') %></p>
                  <p class="mt-1 text-lg font-semibold text-slate-900"><%= row.remaining_amount %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= t('totalAmount') %>: <%= row.total_amount %></p>
                </div>
              </div>

              <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                <div class="record-panel">
                  <p class="record-panel-title"><%= t('quickSummary') %></p>
                  <div class="mt-2 space-y-1 text-slate-700">
                    <div><span class="text-slate-500"><%= t('quantity') %>:</span> <%= row.quantity %></div>
                    <div><span class="text-slate-500"><%= t('price') %>:</span> <%= row.unit_price %></div>
                    <div><span class="text-slate-500"><%= t('jarType') %>:</span> <%= row.jar_name %></div>
                  </div>
                </div>
                <div class="record-panel">
                  <p class="record-panel-title"><%= t('paymentHistoryTitle') %></p>
                  <div class="mt-2 space-y-1 text-slate-700">
                    <div><span class="text-slate-500"><%= t('totalAmount') %>:</span> <%= row.total_amount %></div>
                    <div><span class="text-slate-500"><%= t('paidAmount') %>:</span> <%= row.paid_amount %></div>
                    <div><span class="text-slate-500"><%= t('remainingAmount') %>:</span> <%= row.remaining_amount %></div>
                  </div>
                </div>
                <div class="record-panel">
                  <p class="record-panel-title"><%= t('vehicle') %></p>
                  <div class="mt-2 space-y-1 text-slate-700">
                    <div><span class="text-slate-500"><%= t('vehicle') %>:</span> <%= vehicleLabel %></div>
                    <div><span class="text-slate-500"><%= t('status') %>:</span> <%= statusLabel %></div>
                  </div>
                </div>
                <div class="record-panel">
                  <p class="record-panel-title"><%= t('recordedBy') %></p>
                  <div class="mt-2 space-y-1 text-slate-700">
                    <div><span class="text-slate-500"><%= t('recordedBy') %>:</span> <%= row.recorded_by || '-' %></div>
                    <div><span class="text-slate-500"><%= t('note') %>:</span> <%= row.note || '-' %></div>
                  </div>
                </div>
              </div>

              <div class="record-actions">
                <% if (Number(row.remaining_amount || 0) > 0) { %>
                  <a class="btn-outline btn-sm" href="/records/jar-sales/<%= row.id %>/payments"><%= t('addPayment') %></a>
                <% } %>
                <a class="btn-outline btn-sm" href="/records/jar-sales/<%= row.id %>/payments"><%= t('paymentHistory') %></a>
                <a class="btn-outline btn-sm" href="/records/jar-sales/<%= row.id %>/print" target="_blank"><%= t('print') %></a>
                <a class="btn-outline btn-sm" href="/records/jar-sales/<%= row.id %>/edit"><%= t('edit') %></a>
                <details class="action-menu">
                  <summary class="btn-outline btn-sm">⋯</summary>
                  <div class="action-menu-panel">
                    <form method="post" action="/records/jar-sales/<%= row.id %>/delete" onsubmit="return confirm('<%= t('deleteJarSaleConfirm') %>');">
                      <button class="action-menu-item action-menu-danger" type="submit"><%= t('delete') %></button>
                    </form>
                  </div>
                </details>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="card p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold"><%= t('openCredits') %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= t('paymentHistorySubtitle') %></p>
        </div>
        <a class="btn-outline btn-sm" href="/records/payment-history?from=<%= from %>&to=<%= to %>&source=JAR_SALE"><%= t('paymentHistoryTitle') %></a>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-3 xl:grid-cols-1">
        <div class="surface-muted p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('totalRemaining') %></p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= safeOpenJarSaleCreditSummary.remaining_amount %></p>
          <p class="mt-1 text-xs text-slate-500"><%= t('selectedRange') %></p>
        </div>
        <div class="surface-muted p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('allTimeTotalCredits') %></p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= safeOpenJarSaleCreditAllTime %></p>
          <p class="mt-1 text-xs text-slate-500"><%= t('openCredits') %></p>
        </div>
        <div class="surface-muted p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('entries') %></p>
          <p class="mt-2 text-xl font-semibold text-slate-900"><%= safeOpenJarSaleCreditSummary.entry_count %></p>
          <p class="mt-1 text-xs text-slate-500"><%= t('paidAmount') %>: <%= safeOpenJarSaleCreditSummary.paid_amount %></p>
        </div>
      </div>

      <% if (!safeOpenJarSaleCredits.length) { %>
        <div class="empty-state mt-4">
          <p class="empty-state-title"><%= t('noCredits') %></p>
          <p class="empty-state-copy"><%= t('emptyRangeHint') %></p>
        </div>
      <% } else { %>
        <div class="mt-4 space-y-3">
          <% safeOpenJarSaleCredits.forEach((row) => { %>
            <% const vehicleLabel = row.owner_name ? `${row.owner_name} • ${row.vehicle_number || '-'}` : (row.vehicle_number || '-'); %>
            <div class="record-card">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="font-semibold text-slate-900"><%= row.customer_name || '-' %></p>
                    <span class="status-pill status-pill-unpaid"><%= t('unpaid') %></span>
                    <% if (row.is_company) { %>
                      <span class="status-pill status-pill-company"><%= t('companyVehicle') %></span>
                    <% } %>
                  </div>
                  <p class="mt-1 text-xs text-slate-500"><%= row.sale_date %> • <%= row.jar_name %></p>
                  <p class="mt-2 text-sm text-slate-600"><%= vehicleLabel %></p>
                </div>
                <div class="surface-muted min-w-[170px] px-4 py-3 text-right">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('remainingAmount') %></p>
                  <p class="mt-1 text-lg font-semibold text-red-700"><%= row.remaining_amount %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= t('totalAmount') %>: <%= row.total_amount %></p>
                </div>
              </div>

              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <div class="record-panel">
                  <p class="record-panel-title"><%= t('quickSummary') %></p>
                  <div class="mt-2 space-y-1 text-slate-700">
                    <div><span class="text-slate-500"><%= t('quantity') %>:</span> <%= row.quantity %></div>
                    <div><span class="text-slate-500"><%= t('paidAmount') %>:</span> <%= row.paid_amount %></div>
                  </div>
                </div>
                <div class="record-panel">
                  <p class="record-panel-title"><%= t('vehicle') %></p>
                  <div class="mt-2 space-y-1 text-slate-700">
                    <div><span class="text-slate-500"><%= t('vehicle') %>:</span> <%= vehicleLabel %></div>
                    <div><span class="text-slate-500"><%= t('jarType') %>:</span> <%= row.jar_name %></div>
                  </div>
                </div>
              </div>

              <div class="record-actions">
                <a class="btn-outline btn-sm" href="/records/jar-sales/<%= row.id %>/payments"><%= t('addPayment') %></a>
                <a class="btn-outline btn-sm" href="/records/jar-sales/<%= row.id %>/payments"><%= t('paymentHistory') %></a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>
<%- include('../partials/shell-end') %>
