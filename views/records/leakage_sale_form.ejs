<%- include('../partials/shell-start', { title }) %>
<section class="py-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-3xl font-semibold"><%= t('editLeakageJarSaleTitle') %></h1>
      <p class="text-slate-600"><%= t('leakageJarSaleFormSubtitle') %></p>
    </div>
    <a class="btn-outline" href="/records/leakage-sales?from=<%= record.sale_date %>&to=<%= record.sale_date %>"><%= t('back') %></a>
  </div>

  <% if (error) { %>
    <div class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700"><%= error %></div>
  <% } %>

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
    <div class="card p-6">
      <form class="space-y-4" method="post" action="/records/leakage-sales/<%= record.id %>">
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label class="label"><%= t('date') %></label>
            <input class="input" type="date" name="sale_date" value="<%= record.sale_date %>" required />
          </div>
          <div>
            <label class="label"><%= t('quantity') %></label>
            <input class="input" type="number" min="1" name="quantity" value="<%= record.quantity %>" data-qty required />
          </div>
        </div>
        <div>
          <label class="label"><%= t('pricePerLeakageJar') %></label>
          <input class="input" type="number" min="0.01" step="0.01" name="unit_price" value="<%= record.unit_price %>" data-price required />
        </div>
        <div>
          <label class="label"><%= t('note') %></label>
          <input class="input" type="text" name="note" value="<%= record.note || '' %>" />
        </div>

        <div class="grid gap-3 text-sm sm:grid-cols-3">
          <div class="card p-4">
            <p class="text-slate-500"><%= t('totalAmount') %></p>
            <p class="text-lg font-semibold" data-total>0.00</p>
          </div>
          <div class="card p-4">
            <p class="text-slate-500"><%= t('paidAmount') %></p>
            <p class="text-lg font-semibold"><%= Number(record.paid_amount || 0) %></p>
          </div>
          <div class="card p-4">
            <p class="text-slate-500"><%= t('remainingAmount') %></p>
            <p class="text-lg font-semibold" data-credit>0.00</p>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
          <%= t('leakageJarSaleEditHint') %>
        </div>

        <button class="btn-primary" type="submit"><%= t('save') %></button>
      </form>
    </div>

    <div class="card p-6">
      <h2 class="text-lg font-semibold"><%= t('paymentHistory') %></h2>
      <p class="mt-2 text-sm text-slate-600"><%= t('leakageJarSalePaymentHint') %></p>
      <div class="mt-4 grid gap-3 text-sm">
        <div class="card p-4">
          <p class="text-slate-500"><%= t('paidAmount') %></p>
          <p class="text-lg font-semibold"><%= Number(record.paid_amount || 0) %></p>
        </div>
        <div class="card p-4">
          <p class="text-slate-500"><%= t('creditAmount') %></p>
          <p class="text-lg font-semibold"><%= Number(record.credit_amount || 0) %></p>
        </div>
      </div>
      <a class="btn-outline mt-4 w-full justify-center" href="/records/leakage-sales/<%= record.id %>/payments"><%= t('managePayments') %></a>
    </div>
  </div>
</section>

<script>
  (() => {
    const qtyInput = document.querySelector('[data-qty]');
    const priceInput = document.querySelector('[data-price]');
    const totalEl = document.querySelector('[data-total]');
    const creditEl = document.querySelector('[data-credit]');
    const paidAmount = Number("<%= Number(record.paid_amount || 0) %>");

    const clamp = (value) => {
      const num = Math.round(Math.max(0, Number(value || 0)) * 100) / 100;
      return Number.isNaN(num) ? 0 : num;
    };

    const recalc = () => {
      const qty = Math.max(0, Math.floor(Number(qtyInput?.value || 0)));
      const price = clamp(priceInput?.value || 0);
      const total = clamp(qty * price);
      const credit = clamp(total - paidAmount);
      if (totalEl) totalEl.textContent = total.toFixed(2);
      if (creditEl) creditEl.textContent = Math.max(0, credit).toFixed(2);
    };

    [qtyInput, priceInput].forEach((el) => el && el.addEventListener('input', recalc));
    recalc();
  })();
</script>
<%- include('../partials/shell-end') %>
