<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('exportsTitle') %> | AQUA MSK</title>
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
  <style>
    <%- include('../partials/print-receipt-styles') %>
  </style>
</head>
<body class="text-slate-900">
  <% const toNumber = (value) => Number(value || 0); %>
  <% const rawPaidAmount = toNumber(record.paid_amount); %>
  <% const creditAmount = toNumber(record.credit_amount); %>
  <% const rawTotalExportAmount = toNumber(record.total_amount); %>
  <% const jarCount = toNumber(record.jar_count); %>
  <% const returnJarCount = toNumber(record.return_jar_count); %>
  <% const leakageJarCount = toNumber(record.leakage_jar_count); %>
  <% const netJars = Math.max(0, jarCount - returnJarCount - leakageJarCount); %>
  <% const bottleCaseCount = toNumber(record.bottle_case_count); %>
  <% const returnBottleCaseCount = toNumber(record.return_bottle_case_count); %>
  <% const damagedBottleCaseCount = toNumber(record.damaged_bottle_case_count); %>
  <% const netBottleCases = Math.max(0, bottleCaseCount - returnBottleCaseCount - damagedBottleCaseCount); %>
  <% const dispenserCount = toNumber(record.dispenser_count); %>
  <% const soldJarCount = toNumber(record.sold_jar_count); %>
  <% const soldJarPrice = toNumber(record.sold_jar_price); %>
  <% const soldJarAmount = toNumber(record.sold_jar_amount) || (soldJarCount * soldJarPrice); %>
  <% const jarUnitPrice = toNumber(record.jar_unit_price); %>
  <% const bottleCaseUnitPrice = toNumber(record.bottle_case_unit_price); %>
  <% const dispenserUnitPrice = toNumber(record.dispenser_unit_price); %>
  <% const collectionAmount = Number(record.is_company || 0) === 1 ? toNumber(record.collection_amount) + soldJarAmount : toNumber(record.collection_amount); %>
  <% const totalExportAmount = Number(record.is_company || 0) === 1 ? Math.max(rawTotalExportAmount, collectionAmount) : rawTotalExportAmount; %>
  <% const paidAmount = Number(record.is_company || 0) === 1 ? Math.max(rawPaidAmount, collectionAmount) : rawPaidAmount; %>
  <% const expenseAmount = toNumber(record.expense_amount); %>
  <% const netCollectionAmount = Math.max(0, collectionAmount - expenseAmount); %>
  <% const remainingAmount = Math.max(0, totalExportAmount - paidAmount); %>
  <% const isPaid = paidAmount >= totalExportAmount && totalExportAmount > 0; %>
  <% const isPartial = !isPaid && paidAmount > 0; %>
  <% const statusLabel = isPaid ? t('paid') : (isPartial ? t('statusPartial') : t('unpaid')); %>
  <% const statusClass = isPaid ? 'is-paid' : (isPartial ? 'is-partial' : 'is-unpaid'); %>
  <% const paymentMethodLabel = record.payment_method === 'BANK' ? t('methodBank') : record.payment_method === 'E_WALLET' ? t('methodEWallet') : record.payment_method === 'MIXED' ? t('methodMixed') : t('methodCash'); %>
  <% const itemLines = []; %>
  <% if (netJars > 0) { %>
    <% itemLines.push({ label: t('jars'), qty: netJars, unitPrice: jarUnitPrice, amount: netJars * jarUnitPrice, detail: `${t('returnJars')}: ${returnJarCount}, ${t('leakageJars')}: ${leakageJarCount}` }); %>
  <% } %>
  <% if (netBottleCases > 0) { %>
    <% itemLines.push({ label: t('bottleCases'), qty: netBottleCases, unitPrice: bottleCaseUnitPrice, amount: netBottleCases * bottleCaseUnitPrice, detail: `${t('returnBottleCases')}: ${returnBottleCaseCount}, ${t('damagedBottleCases')}: ${damagedBottleCaseCount}` }); %>
  <% } %>
  <% if (dispenserCount > 0) { %>
    <% itemLines.push({ label: t('dispensers'), qty: dispenserCount, unitPrice: dispenserUnitPrice, amount: dispenserCount * dispenserUnitPrice }); %>
  <% } %>
  <% if (soldJarCount > 0 || soldJarAmount > 0) { %>
    <% itemLines.push({ label: t('soldJars'), qty: soldJarCount, unitPrice: soldJarPrice, amount: soldJarAmount }); %>
  <% } %>

  <div class="receipt-page">
    <div class="receipt-topbar print-hidden">
      <button class="btn-primary" onclick="window.print()"><%= t('print') %></button>
    </div>

    <div class="receipt-card">
      <%- include('../partials/print-brand', { subtitle: t('exportsTitle') }) %>

      <div class="receipt-chip-row">
        <span class="receipt-chip <%= statusClass %>"><%= t('status') %>: <%= statusLabel %></span>
        <span class="receipt-chip"><%= t('paymentMethodLabel') %>: <%= paymentMethodLabel %></span>
        <% if (record.route) { %>
          <span class="receipt-chip"><%= t('route') %>: <%= record.route %></span>
        <% } %>
      </div>

      <div class="receipt-meta-grid">
        <div>
          <p class="receipt-meta-label"><%= t('receiptNo') %></p>
          <p class="receipt-meta-value"><%= record.receipt_no || (`#${record.id}`) %></p>
        </div>
        <div>
          <p class="receipt-meta-label"><%= t('date') %></p>
          <p class="receipt-meta-value"><%= typeof formatDateDual === 'function' ? formatDateDual(record.export_date) : record.export_date %></p>
        </div>
        <div>
          <p class="receipt-meta-label"><%= t('vehicleNumber') %></p>
          <p class="receipt-meta-value"><%= record.vehicle_number %></p>
        </div>
        <div>
          <p class="receipt-meta-label"><%= t('ownerName') %></p>
          <p class="receipt-meta-value"><%= record.owner_name %></p>
        </div>
        <% if (record.phone) { %>
          <div>
            <p class="receipt-meta-label"><%= t('phone') %></p>
            <p class="receipt-meta-value"><%= record.phone %></p>
          </div>
        <% } %>
        <% if (record.checked_by_name) { %>
          <div>
            <p class="receipt-meta-label"><%= t('checkedByStaffName') %></p>
            <p class="receipt-meta-value"><%= record.checked_by_name %></p>
          </div>
        <% } %>
      </div>

      <div class="receipt-divider"></div>

      <p class="receipt-section-title"><%= t('allItems') %></p>
      <% if (itemLines.length === 0) { %>
        <p class="mt-2 text-xs text-slate-500"><%= t('noData') %></p>
      <% } else { %>
        <div class="mt-1">
          <div class="receipt-line-head">
            <span><%= t('allItems') %></span>
            <span><%= t('quantity') %></span>
            <span><%= t('amount') %></span>
          </div>
          <% itemLines.forEach((item) => { %>
            <div class="receipt-line">
              <div>
                <p class="receipt-line-name"><%= item.label %></p>
                <% if (item.detail) { %>
                  <p class="receipt-line-sub"><%= item.detail %></p>
                <% } %>
                <% if (item.unitPrice > 0) { %>
                  <p class="receipt-line-sub"><%= t('unit') %>: <%= item.unitPrice %></p>
                <% } %>
              </div>
              <p class="receipt-line-value"><%= item.qty %></p>
              <p class="receipt-line-value"><%= item.amount > 0 ? item.amount : '-' %></p>
            </div>
          <% }) %>
        </div>
      <% } %>

      <div class="receipt-divider"></div>

      <div class="receipt-totals">
        <div class="row">
          <span><%= t('totalExportAmount') %></span>
          <strong><%= totalExportAmount %></strong>
        </div>
        <div class="row">
          <span><%= t('paidAmount') %></span>
          <strong><%= paidAmount %></strong>
        </div>
        <div class="row">
          <span><%= t('creditAmount') %></span>
          <strong><%= creditAmount %></strong>
        </div>
        <% if (collectionAmount > 0 || expenseAmount > 0) { %>
          <div class="row">
            <span><%= t('collectionAmount') %></span>
            <strong><%= collectionAmount %></strong>
          </div>
          <% if (expenseAmount > 0) { %>
            <div class="row">
              <span><%= t('expenseAmount') %></span>
              <strong><%= expenseAmount %></strong>
            </div>
          <% } %>
          <div class="row">
            <span><%= t('netCollectionAmount') %></span>
            <strong><%= netCollectionAmount %></strong>
          </div>
        <% } %>
        <div class="row final">
          <span><%= t('remainingAmount') %></span>
          <strong><%= remainingAmount %></strong>
        </div>
      </div>

      <% if (record.note || record.expense_note) { %>
        <div class="receipt-note">
          <% if (record.note) { %>
            <div><strong><%= t('note') %>:</strong> <%= record.note %></div>
          <% } %>
          <% if (record.expense_note) { %>
            <div><strong><%= t('expenseNote') %>:</strong> <%= record.expense_note %></div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
