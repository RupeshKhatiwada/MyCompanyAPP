<%- include('../partials/shell-start', { title }) %>
<section class="py-8">
  <%
    const selectedVehicleOption = (vehicles || []).find((vehicle) => String(vehicle.id) === String(vehicleId));
    const selectedVehicleLabel = selectedVehicleOption
      ? `${selectedVehicleOption.owner_name} • ${selectedVehicleOption.vehicle_number}`
      : t('allVehicles');
    const combinedBalance = Object.values(balances || {}).reduce((sum, amount) => sum + Number(amount || 0), 0);
    const displayBalance = vehicleId === 'all' ? combinedBalance : Number((balances && balances[vehicleId]) || 0);
  %>

  <div class="page-header">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold"><%= t('savingsTitle') %></h1>
        <p class="mt-1 text-slate-600"><%= t('savingsSubtitle') %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn-outline" href="/records/payment-history?from=<%= encodeURIComponent(from) %>&to=<%= encodeURIComponent(to) %>&source=SAVINGS"><%= t('paymentHistoryTitle') %></a>
        <a class="btn-outline" href="/records/savings/export-csv?from=<%= encodeURIComponent(from) %>&to=<%= encodeURIComponent(to) %>&vehicle_id=<%= encodeURIComponent(vehicleId) %>"><%= t('exportCsv') %></a>
        <a class="btn-outline" href="/records/savings/print?from=<%= encodeURIComponent(from) %>&to=<%= encodeURIComponent(to) %>&vehicle_id=<%= encodeURIComponent(vehicleId) %>" target="_blank"><%= t('print') %></a>
      </div>
    </div>
  </div>

  <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('totalSavings') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= totals.total %></p>
      <p class="mt-1 text-xs text-slate-500"><%= from %> -> <%= to %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('savingsDeposit') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= totals.deposits %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t('entries') %>: <%= entries.length %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('savingsWithdraw') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= totals.withdraws %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t('vehicle') %>: <%= selectedVehicleLabel %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('balance') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= displayBalance %></p>
      <p class="mt-1 text-xs text-slate-500"><%= vehicleId === 'all' ? t('allVehicles') : selectedVehicleLabel %></p>
    </div>
  </div>

  <div class="mt-6 card p-5">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="surface-muted px-4 py-3 text-sm text-slate-600">
        <div><span class="font-medium text-slate-800"><%= t('selectedRange') %>:</span> <%= from %> -> <%= to %></div>
        <div class="mt-1"><span class="font-medium text-slate-800"><%= t('vehicle') %>:</span> <%= selectedVehicleLabel %></div>
      </div>
      <div class="flex flex-wrap gap-2 text-sm">
        <a class="btn-outline" href="/records/savings?from=<%= today %>&to=<%= today %>&vehicle_id=<%= encodeURIComponent(vehicleId) %>"><%= t('presetToday') %></a>
        <a class="btn-outline" href="/records/savings?from=<%= monthStart %>&to=<%= today %>&vehicle_id=<%= encodeURIComponent(vehicleId) %>"><%= t('presetThisMonth') %></a>
        <a class="btn-outline" href="/records/savings?from=<%= yearStart %>&to=<%= today %>&vehicle_id=<%= encodeURIComponent(vehicleId) %>"><%= t('presetThisYear') %></a>
      </div>
    </div>

    <form class="mt-5 grid gap-3 lg:grid-cols-4" method="get" action="/records/savings">
      <div>
        <label class="label"><%= t('from') %></label>
        <input class="input mt-1" type="date" name="from" value="<%= from %>" />
      </div>
      <div>
        <label class="label"><%= t('to') %></label>
        <input class="input mt-1" type="date" name="to" value="<%= to %>" />
      </div>
      <div class="lg:col-span-2">
        <label class="label"><%= t('vehicle') %></label>
        <select class="input mt-1" name="vehicle_id">
          <option value="all"><%= t('allVehicles') %></option>
          <% vehicles.forEach((vehicle) => { %>
            <% const label = `${vehicle.owner_name} • ${vehicle.vehicle_number}`; %>
            <option value="<%= vehicle.id %>" <%= String(vehicleId) === String(vehicle.id) ? 'selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </div>
      <div class="lg:col-span-4 flex justify-end">
        <button class="btn-outline" type="submit"><%= t('filter') %></button>
      </div>
    </form>
  </div>

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(320px,0.95fr)_minmax(0,1.15fr)]">
    <div class="card p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold"><%= t('addSavingsEntry') %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= t('savingsSubtitle') %></p>
        </div>
        <div class="surface-muted px-3 py-2 text-xs text-slate-500"><%= t('balance') %>: <%= displayBalance %></div>
      </div>

      <form class="mt-5 grid gap-3 sm:grid-cols-2" method="post" action="/records/savings" data-savings-form>
        <div class="sm:col-span-2">
          <label class="label"><%= t('vehicle') %></label>
          <select class="input mt-1" name="vehicle_id" required>
            <option value=""><%= t('selectVehicle') %></option>
            <% vehicles.forEach((vehicle) => { %>
              <% const label = `${vehicle.owner_name} • ${vehicle.vehicle_number}`; %>
              <option value="<%= vehicle.id %>"><%= label %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="label"><%= t('savingsType') %></label>
          <select class="input mt-1" name="entry_type" required data-savings-type>
            <option value="deposit"><%= t('savingsDeposit') %></option>
            <option value="withdraw"><%= t('savingsWithdraw') %></option>
          </select>
        </div>
        <div data-savings-source-wrap>
          <label class="label"><%= t('paymentSourceLabel') %></label>
          <select class="input mt-1" name="payment_source" data-savings-source>
            <option value="DAILY_COLLECTION"><%= t('sourceDailyCollection') %></option>
            <option value="OWNER_PERSONAL"><%= t('sourceOwnerPersonal') %></option>
            <option value="BANK_OTHER"><%= t('sourceBankOther') %></option>
          </select>
          <p class="mt-1 text-xs text-slate-500" data-savings-source-hint><%= t('savingsDepositSourceFixed') %></p>
        </div>
        <div>
          <label class="label"><%= t('amount') %></label>
          <input class="input mt-1" type="number" step="0.01" min="0" name="amount" required />
        </div>
        <div>
          <label class="label"><%= t('date') %></label>
          <input class="input mt-1" type="date" name="entry_date" value="<%= to %>" required />
        </div>
        <div class="sm:col-span-2">
          <label class="label"><%= t('note') %></label>
          <input class="input mt-1" type="text" name="note" placeholder="<%= t('optionalNote') %>" />
        </div>
        <div class="sm:col-span-2">
          <button class="btn-primary w-full sm:w-auto" type="submit"><%= t('save') %></button>
        </div>
      </form>
    </div>

    <div class="card p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold"><%= t('summary') %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= t('paymentHistoryEverythingHint') %></p>
        </div>
        <div class="text-sm text-slate-500"><%= entries.length %> <%= t('entries').toLowerCase() %></div>
      </div>

      <% if (!entries || !entries.length) { %>
        <div class="surface-muted mt-4 p-5 text-sm text-slate-500"><%= t('noSavings') %></div>
      <% } else { %>
        <div class="mt-4 space-y-3">
          <% entries.forEach((row) => { %>
            <%
              const label = `${row.owner_name} • ${row.vehicle_number}`;
              const entryType = row.amount < 0 ? 'withdraw' : 'deposit';
              const sourceLabel = row.payment_source === 'OWNER_PERSONAL' ? t('sourceOwnerPersonal') : row.payment_source === 'BANK_OTHER' ? t('sourceBankOther') : t('sourceDailyCollection');
              const amountValue = Math.abs(row.amount);
            %>
            <div class="record-card">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="font-semibold text-slate-900"><%= label %></p>
                    <span class="badge <%= entryType === 'withdraw' ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-700' %>">
                      <%= entryType === 'withdraw' ? t('savingsWithdraw') : t('savingsDeposit') %>
                    </span>
                  </div>
                  <p class="mt-1 text-xs text-slate-500"><%= row.entry_date %></p>
                </div>
                <div class="surface-muted min-w-[180px] px-4 py-3 text-right">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('amount') %></p>
                  <p class="mt-1 text-lg font-semibold <%= entryType === 'withdraw' ? 'text-red-700' : 'text-emerald-700' %>"><%= amountValue %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= t('balance') %>: <%= balances[row.vehicle_id] || 0 %></p>
                </div>
              </div>

              <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                <div class="surface-muted p-3 text-sm">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('paymentSourceLabel') %></p>
                  <div class="mt-2 text-slate-700"><%= sourceLabel %></div>
                </div>
                <div class="surface-muted p-3 text-sm">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('note') %></p>
                  <div class="mt-2 text-slate-700"><%= row.note || '-' %></div>
                </div>
                <div class="surface-muted p-3 text-sm">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('recordedBy') %></p>
                  <div class="mt-2 text-slate-700"><%= row.recorded_by || '-' %></div>
                </div>
              </div>

              <div class="mt-4 flex flex-wrap gap-2">
                <a class="btn-outline btn-sm" href="/records/savings/<%= row.id %>/edit"><%= t('edit') %></a>
                <details class="action-menu">
                  <summary class="btn-outline btn-sm">⋯</summary>
                  <div class="action-menu-panel">
                    <form method="post" action="/records/savings/<%= row.id %>/delete" onsubmit="return confirm('<%= t('deleteSavingsEntryConfirm') %>');">
                      <button class="action-menu-item action-menu-danger" type="submit"><%= t('delete') %></button>
                    </form>
                  </div>
                </details>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>
<script>
  (() => {
    const form = document.querySelector("[data-savings-form]");
    if (!form) return;
    const typeSelect = form.querySelector("[data-savings-type]");
    const sourceWrap = form.querySelector("[data-savings-source-wrap]");
    const sourceSelect = form.querySelector("[data-savings-source]");
    const sourceHint = form.querySelector("[data-savings-source-hint]");
    if (!typeSelect || !sourceWrap || !sourceSelect || !sourceHint) return;

    const updateSourceUI = () => {
      const isWithdraw = typeSelect.value === "withdraw";
      if (isWithdraw) {
        sourceWrap.classList.remove("opacity-60");
        sourceSelect.disabled = false;
        sourceHint.classList.add("hidden");
      } else {
        sourceSelect.value = "DAILY_COLLECTION";
        sourceSelect.disabled = true;
        sourceWrap.classList.add("opacity-60");
        sourceHint.classList.remove("hidden");
      }
    };

    typeSelect.addEventListener("change", updateSourceUI);
    updateSourceUI();
  })();
</script>
<%- include('../partials/shell-end') %>
