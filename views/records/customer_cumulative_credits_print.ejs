<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('customerCumulativeCreditsTitle') %> | AQUA MSK</title>
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
  <style>
    .print-report-header {
      border-bottom: 1px solid #cbd5e1;
      padding-bottom: 10px;
    }
    @media print {
      @page {
        size: A4 portrait;
        margin: 10mm;
      }
      .print-hidden { display: none !important; }
      .print-sheet {
        max-width: none !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .print-table-wrap {
        overflow: visible !important;
      }
      .print-table {
        width: 100% !important;
        font-size: 10px !important;
      }
      .print-table thead {
        display: table-header-group !important;
      }
      .print-table th,
      .print-table td {
        padding: 4px 6px !important;
        vertical-align: top;
      }
      .print-table tr {
        break-inside: avoid;
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body class="bg-white text-slate-900">
  <div class="print-sheet mx-auto max-w-5xl p-6">
    <div class="print-report-header flex items-start justify-between gap-4">
      <div class="flex-1">
        <%- include('../partials/print-brand', { subtitle: t('customerCumulativeCreditsTitle') }) %>
        <p class="mt-2 text-sm text-slate-600">
          <strong><%= t('customerName') %>:</strong> <%= customerName %>
        </p>
        <p class="text-sm text-slate-600">
          <strong><%= t('from') %>:</strong> <%= typeof formatDateDual === 'function' ? formatDateDual(from) : from %>
          &nbsp; <strong><%= t('to') %>:</strong> <%= typeof formatDateDual === 'function' ? formatDateDual(to) : to %>
        </p>
        <p class="text-xs text-slate-500"><%= t('dateTime') %>: <%= printedAt %></p>
      </div>
      <button class="btn-primary print-hidden" onclick="window.print()"><%= t('print') %></button>
    </div>

    <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 print-table-wrap">
      <table class="table-base print-table">
        <thead class="table-head">
          <tr>
            <th class="px-4 py-3"><%= t('date') %></th>
            <th class="px-4 py-3"><%= t('tripDate') %></th>
            <th class="px-4 py-3"><%= t('vehicle') %></th>
            <th class="px-4 py-3"><%= t('receiptNo') %></th>
            <th class="px-4 py-3"><%= t('creditJars') %></th>
            <th class="px-4 py-3"><%= t('amount') %></th>
            <th class="px-4 py-3"><%= t('paidAmount') %></th>
            <th class="px-4 py-3"><%= t('remainingAmount') %></th>
          </tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %>
            <tr>
              <td class="px-4 py-4 text-slate-500" colspan="8"><%= t('noCredits') %></td>
            </tr>
          <% } %>
          <% rows.forEach((row) => { %>
            <tr class="table-row">
              <td class="px-4 py-3"><%= typeof formatDateDual === 'function' ? formatDateDual(row.credit_date) : row.credit_date %></td>
              <td class="px-4 py-3"><%= row.trip_date ? (typeof formatDateDual === 'function' ? formatDateDual(row.trip_date) : row.trip_date) : '-' %></td>
              <td class="px-4 py-3"><%= `${row.owner_name || '-'} • ${row.vehicle_number || '-'}` %></td>
              <td class="px-4 py-3"><%= row.trip_receipt_no || (`#${row.id}`) %></td>
              <td class="px-4 py-3"><%= row.credit_jars || 0 %></td>
              <td class="px-4 py-3"><%= row.amount || 0 %></td>
              <td class="px-4 py-3"><%= row.paid_amount || 0 %></td>
              <td class="px-4 py-3"><%= row.remaining_amount || 0 %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-5">
      <div class="card p-4">
        <p class="text-slate-500"><%= t('entries') %></p>
        <p class="text-lg font-semibold"><%= totals.entry_count %></p>
      </div>
      <div class="card p-4">
        <p class="text-slate-500"><%= t('totalCreditJars') %></p>
        <p class="text-lg font-semibold"><%= totals.total_jars %></p>
      </div>
      <div class="card p-4">
        <p class="text-slate-500"><%= t('totalAmount') %></p>
        <p class="text-lg font-semibold"><%= totals.total_amount %></p>
      </div>
      <div class="card p-4">
        <p class="text-slate-500"><%= t('totalPaidAmount') %></p>
        <p class="text-lg font-semibold"><%= totals.total_paid %></p>
      </div>
      <div class="card p-4">
        <p class="text-slate-500"><%= t('totalRemaining') %></p>
        <p class="text-lg font-semibold"><%= totals.total_remaining %></p>
      </div>
    </div>
  </div>
</body>
</html>
