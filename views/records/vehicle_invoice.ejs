<%- include('../partials/shell-start', { title }) %>
<section class="py-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-3xl font-semibold"><%= t('vehicleInvoiceTitle') %></h1>
      <p class="text-slate-600"><%= t('vehicleInvoiceSubtitle') %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if (vehicle) { %>
        <form method="post" action="/records/vehicle-invoice/print" target="_blank">
          <input type="hidden" name="from" value="<%= from %>" />
          <input type="hidden" name="to" value="<%= to %>" />
          <input type="hidden" name="vehicle_id" value="<%= vehicle.id %>" />
          <button class="btn-primary" type="submit"><%= t('oneClickInvoicePdf') %></button>
        </form>
        <a class="btn-outline" href="/records/vehicle-invoice/export?from=<%= from %>&to=<%= to %>&vehicle_id=<%= vehicle.id %>"><%= t('exportCsv') %></a>
      <% } %>
    </div>
  </div>

  <form class="mt-4 flex flex-wrap items-end gap-3" method="get" action="/records/vehicle-invoice">
    <div>
      <label class="label"><%= t('from') %></label>
      <input class="input" type="date" name="from" value="<%= from %>" />
    </div>
    <div>
      <label class="label"><%= t('to') %></label>
      <input class="input" type="date" name="to" value="<%= to %>" />
    </div>
    <div class="min-w-[240px]">
      <label class="label"><%= t('selectVehicle') %></label>
      <select class="input" name="vehicle_id">
        <option value=""><%= t('selectVehicle') %></option>
        <% (vehicles || []).forEach((item) => { %>
          <option value="<%= item.id %>" <%= Number(vehicleId || 0) === Number(item.id) ? 'selected' : '' %>>
            <%= `${item.vehicle_number} • ${item.owner_name}` %>
          </option>
        <% }) %>
      </select>
    </div>
    <button class="btn-outline" type="submit"><%= t('run') %></button>
  </form>

  <% if (!vehicle) { %>
    <div class="mt-6 card p-6 text-sm text-slate-600"><%= t('vehicleInvoiceHint') %></div>
  <% } %>

  <% if (vehicle) { %>
    <div class="mt-6 grid gap-3 text-sm sm:grid-cols-3 lg:grid-cols-6">
      <div class="card p-4">
        <p class="text-slate-500"><%= t('tripCount') %></p>
        <p class="text-lg font-semibold"><%= totals.total_trips %></p>
      </div>
      <div class="card p-4">
        <p class="text-slate-500"><%= t('totalJars') %></p>
        <p class="text-lg font-semibold"><%= totals.total_jars %></p>
      </div>
      <div class="card p-4">
        <p class="text-slate-500"><%= t('netJars') %></p>
        <p class="text-lg font-semibold"><%= totals.total_net_jars %></p>
      </div>
      <div class="card p-4">
        <p class="text-slate-500"><%= t('totalAmount') %></p>
        <p class="text-lg font-semibold"><%= totals.total_amount %></p>
      </div>
      <div class="card p-4">
        <p class="text-slate-500"><%= t('totalPaidAmount') %></p>
        <p class="text-lg font-semibold"><%= totals.total_paid %></p>
      </div>
      <div class="card p-4">
        <p class="text-slate-500"><%= t('totalRemaining') %></p>
        <p class="text-lg font-semibold"><%= totals.total_remaining %></p>
      </div>
      <div class="card p-4">
        <p class="text-slate-500"><%= t('savingsTitle') %></p>
        <p class="text-lg font-semibold"><%= totals.total_savings || 0 %></p>
      </div>
    </div>

    <div class="mt-6 card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="table-base">
          <thead class="table-head">
            <tr>
              <th class="px-4 py-3"><%= t('date') %></th>
              <th class="px-4 py-3"><%= t('receiptNo') %></th>
              <th class="px-4 py-3"><%= t('jarCount') %></th>
              <th class="px-4 py-3"><%= t('netJars') %></th>
              <th class="px-4 py-3"><%= t('amount') %></th>
              <th class="px-4 py-3"><%= t('paidAmount') %></th>
              <th class="px-4 py-3"><%= t('remainingAmount') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows || rows.length === 0) { %>
              <tr>
                <td class="px-4 py-4 text-slate-500" colspan="7"><%= t('noExports') %></td>
              </tr>
            <% } %>
            <% (rows || []).forEach((row) => { %>
              <tr class="table-row">
                <td class="px-4 py-3"><%= row.export_date %></td>
                <td class="px-4 py-3"><%= row.receipt_no || (`#${row.id}`) %></td>
                <td class="px-4 py-3"><%= row.jar_count || 0 %></td>
                <td class="px-4 py-3"><%= row.net_jars || 0 %></td>
                <td class="px-4 py-3"><%= row.total_amount || 0 %></td>
                <td class="px-4 py-3"><%= row.paid_amount || 0 %></td>
                <td class="px-4 py-3"><%= row.remaining_amount || 0 %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-6 card overflow-hidden">
      <div class="border-b border-slate-200 px-6 py-4">
        <h2 class="text-lg font-semibold"><%= t('savingsByDateTitle') %></h2>
        <p class="text-sm text-slate-500"><%= t('partnerSavingsInvoiceSubtitle') %></p>
      </div>
      <div class="overflow-x-auto">
        <table class="table-base">
          <thead class="table-head">
            <tr>
              <th class="px-4 py-3"><%= t('date') %></th>
              <th class="px-4 py-3"><%= t('savingsTitle') %></th>
              <th class="px-4 py-3"><%= t('note') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (!(savingsRows || []).length) { %>
              <tr>
                <td class="px-4 py-4 text-slate-500" colspan="3"><%= t('noSavingsRows') %></td>
              </tr>
            <% } %>
            <% (savingsRows || []).forEach((row) => { %>
              <tr class="table-row">
                <td class="px-4 py-3"><%= typeof formatDateDual === 'function' ? formatDateDual(row.entry_date) : row.entry_date %></td>
                <td class="px-4 py-3"><%= row.savings_amount || 0 %></td>
                <td class="px-4 py-3"><%= row.notes || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</section>
<%- include('../partials/shell-end') %>
