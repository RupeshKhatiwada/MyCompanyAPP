<%- include('../partials/shell-start', { title }) %>
<section class="py-8">
  <div class="page-header">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold"><%= t('jarContainerLendingReturnsTitle') %></h1>
        <p class="mt-1 text-slate-600"><%= t('jarContainerLendingReturnsSubtitle') %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn-outline" href="/records/jar-container-lending/<%= record.id %>/payments"><%= t('depositHistory') %></a>
        <a class="btn-outline" href="/records/jar-container-lending?from=<%= record.lend_date %>&to=<%= record.lend_date %>"><%= t('back') %></a>
      </div>
    </div>
  </div>

  <% if (error) { %>
    <div class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= success %></div>
  <% } %>

  <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('customer') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= record.customer_name %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('quantity') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= Number(record.quantity || 0) %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('returnedQuantity') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= Number(record.returned_quantity || 0) %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('outstandingQuantity') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= Number(record.outstanding_quantity || 0) %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('depositHeld') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= Number(record.deposit_held || 0) %></p>
    </div>
  </div>

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(320px,0.95fr)_minmax(0,1.15fr)]">
    <div class="card p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold"><%= t('addReturn') %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= record.jar_name %><% if (record.location) { %> • <%= record.location %><% } %></p>
        </div>
        <div class="surface-muted px-3 py-2 text-xs text-slate-500"><%= t('outstandingQuantity') %>: <%= Number(record.outstanding_quantity || 0) %></div>
      </div>

      <form class="mt-5 space-y-4" method="post" action="/records/jar-container-lending/<%= record.id %>/returns">
        <div>
          <label class="label"><%= t('date') %></label>
          <input class="input mt-1" type="date" name="return_date" value="<%= record.lend_date %>" required />
        </div>
        <div>
          <label class="label"><%= t('returnedQuantity') %></label>
          <input class="input mt-1" type="number" min="1" max="<%= Number(record.outstanding_quantity || 0) %>" name="quantity" value="1" required />
        </div>
        <div class="surface-muted p-4">
          <h3 class="text-base font-semibold"><%= t('depositRefundOptional') %></h3>
          <div class="mt-3 grid gap-3 sm:grid-cols-3">
            <div>
              <label class="label"><%= t('methodCash') %></label>
              <input class="input mt-1" type="number" step="0.01" min="0" max="<%= Number(record.deposit_held || 0) %>" name="refund_cash_amount" data-cash />
            </div>
            <div>
              <label class="label"><%= t('methodBank') %></label>
              <input class="input mt-1" type="number" step="0.01" min="0" max="<%= Number(record.deposit_held || 0) %>" name="refund_bank_amount" data-bank />
            </div>
            <div>
              <label class="label"><%= t('methodEWallet') %></label>
              <input class="input mt-1" type="number" step="0.01" min="0" max="<%= Number(record.deposit_held || 0) %>" name="refund_ewallet_amount" data-ewallet />
            </div>
          </div>
          <div class="mt-3">
            <label class="label"><%= t('refundAmount') %></label>
            <input class="input mt-1 bg-slate-50" type="number" step="0.01" min="0" name="refund_amount" data-total readonly />
          </div>
          <input type="hidden" name="refund_method" value="CASH" />
        </div>
        <div>
          <label class="label"><%= t('note') %></label>
          <input class="input mt-1" type="text" name="note" />
        </div>
        <button class="btn-primary w-full sm:w-auto" type="submit"><%= t('save') %></button>
      </form>
    </div>

    <div class="card p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold"><%= t('jarContainerLendingReturnsTitle') %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= t('jarContainerLendingReturnsSubtitle') %></p>
        </div>
        <div class="text-sm text-slate-500"><%= (returns || []).length %> <%= t('entries').toLowerCase() %></div>
      </div>

      <% if (!returns || returns.length === 0) { %>
        <div class="surface-muted mt-4 p-5 text-sm text-slate-500"><%= t('noData') %></div>
      <% } else { %>
        <div class="mt-4 space-y-3">
          <% returns.forEach((row) => { %>
            <% const methodLabel = row.refund_method === 'BANK' ? t('methodBank') : row.refund_method === 'E_WALLET' ? t('methodEWallet') : row.refund_method === 'MIXED' ? t('methodMixed') : t('methodCash'); %>
            <div class="record-card">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="font-semibold text-slate-900"><%= row.return_date %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= row.receipt_no || '-' %></p>
                </div>
                <div class="surface-muted min-w-[170px] px-4 py-3 text-right">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('refundAmount') %></p>
                  <p class="mt-1 text-lg font-semibold text-slate-900"><%= Number(row.refund_amount || 0) %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= Number(row.refund_amount || 0) > 0 ? methodLabel : '-' %></p>
                </div>
              </div>

              <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                <div class="surface-muted p-3 text-sm">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('returnedQuantity') %></p>
                  <div class="mt-2 text-slate-700"><%= row.quantity %></div>
                </div>
                <div class="surface-muted p-3 text-sm">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('note') %></p>
                  <div class="mt-2 text-slate-700"><%= row.note || '-' %></div>
                </div>
                <div class="surface-muted p-3 text-sm">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('recordedBy') %></p>
                  <div class="mt-2 text-slate-700"><%= row.recorded_by || '-' %></div>
                </div>
              </div>

              <div class="mt-4 flex flex-wrap gap-2">
                <a class="btn-outline btn-sm" href="/records/jar-container-lending/returns/<%= row.id %>/print?autoprint=1" target="_blank"><%= t('print') %></a>
                <form method="post" action="/records/jar-container-lending/returns/<%= row.id %>/delete" onsubmit="return confirm('<%= t('deleteReturnConfirm') %>');">
                  <button class="btn-outline btn-sm" type="submit"><%= t('delete') %></button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>

<script>
  (() => {
    const maxTotal = Number("<%= Number(record.deposit_held || 0) %>");
    const cashInput = document.querySelector("[data-cash]");
    const bankInput = document.querySelector("[data-bank]");
    const walletInput = document.querySelector("[data-ewallet]");
    const totalInput = document.querySelector("[data-total]");
    const methodInput = document.querySelector('input[name="refund_method"]');
    if (!cashInput || !bankInput || !walletInput || !totalInput) return;

    const toSafe = (value) => {
      const num = Number(value || 0);
      if (Number.isNaN(num) || num < 0) return 0;
      return num;
    };
    const formatMoneyInput = (value) => {
      const safe = Math.round(toSafe(value) * 100) / 100;
      return safe > 0 ? String(safe) : "";
    };

    const recalc = () => {
      let cash = toSafe(cashInput.value);
      let bank = toSafe(bankInput.value);
      let wallet = toSafe(walletInput.value);
      let remainingTotal = Math.max(maxTotal, 0);
      const clamp = (value) => {
        const used = Math.min(value, remainingTotal);
        remainingTotal -= used;
        return used;
      };
      cash = clamp(cash);
      bank = clamp(bank);
      wallet = clamp(wallet);
      cashInput.value = formatMoneyInput(cash);
      bankInput.value = formatMoneyInput(bank);
      walletInput.value = formatMoneyInput(wallet);
      const total = cash + bank + wallet;
      totalInput.value = formatMoneyInput(total);
      if (methodInput) {
        methodInput.value = wallet > 0 ? "E_WALLET" : bank > 0 ? "BANK" : "CASH";
      }
    };

    [cashInput, bankInput, walletInput].forEach((el) => el.addEventListener("input", recalc));
    recalc();
  })();
</script>
<%- include('../partials/shell-end') %>
