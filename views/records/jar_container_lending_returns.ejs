<%- include('../partials/shell-start', { title }) %>
<section class="py-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-3xl font-semibold"><%= t('jarContainerLendingReturnsTitle') %></h1>
      <p class="text-slate-600"><%= t('jarContainerLendingReturnsSubtitle') %></p>
    </div>
    <a class="btn-outline" href="/records/jar-container-lending?from=<%= record.lend_date %>&to=<%= record.lend_date %>"><%= t('back') %></a>
  </div>

  <% if (error) { %>
    <div class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="mt-4 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= success %></div>
  <% } %>

  <div class="mt-6 grid gap-4 lg:grid-cols-5">
    <div class="card p-4">
      <p class="text-slate-500"><%= t('customer') %></p>
      <p class="text-lg font-semibold"><%= record.customer_name %></p>
    </div>
    <div class="card p-4">
      <p class="text-slate-500"><%= t('quantity') %></p>
      <p class="text-lg font-semibold"><%= Number(record.quantity || 0) %></p>
    </div>
    <div class="card p-4">
      <p class="text-slate-500"><%= t('returnedQuantity') %></p>
      <p class="text-lg font-semibold"><%= Number(record.returned_quantity || 0) %></p>
    </div>
    <div class="card p-4">
      <p class="text-slate-500"><%= t('outstandingQuantity') %></p>
      <p class="text-lg font-semibold"><%= Number(record.outstanding_quantity || 0) %></p>
    </div>
    <div class="card p-4">
      <p class="text-slate-500"><%= t('depositHeld') %></p>
      <p class="text-lg font-semibold"><%= Number(record.deposit_held || 0) %></p>
    </div>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[360px_minmax(0,1fr)]">
    <div class="card p-6">
      <h2 class="text-lg font-semibold"><%= t('addReturn') %></h2>
      <form class="mt-4 space-y-4" method="post" action="/records/jar-container-lending/<%= record.id %>/returns">
        <div>
          <label class="label"><%= t('date') %></label>
          <input class="input" type="date" name="return_date" value="<%= record.lend_date %>" required />
        </div>
        <div>
          <label class="label"><%= t('returnedQuantity') %></label>
          <input class="input" type="number" min="1" max="<%= Number(record.outstanding_quantity || 0) %>" name="quantity" value="1" required />
        </div>
        <div class="rounded-2xl border border-slate-200 p-4">
          <h3 class="text-sm font-semibold"><%= t('depositRefundOptional') %></h3>
          <div class="mt-3 grid gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
            <div>
              <label class="label"><%= t('methodCash') %></label>
              <input class="input" type="number" step="0.01" min="0" max="<%= Number(record.deposit_held || 0) %>" name="refund_cash_amount" data-cash />
            </div>
            <div>
              <label class="label"><%= t('methodBank') %></label>
              <input class="input" type="number" step="0.01" min="0" max="<%= Number(record.deposit_held || 0) %>" name="refund_bank_amount" data-bank />
            </div>
            <div>
              <label class="label"><%= t('methodEWallet') %></label>
              <input class="input" type="number" step="0.01" min="0" max="<%= Number(record.deposit_held || 0) %>" name="refund_ewallet_amount" data-ewallet />
            </div>
          </div>
          <div class="mt-3">
            <label class="label"><%= t('refundAmount') %></label>
            <input class="input bg-slate-50" type="number" step="0.01" min="0" name="refund_amount" data-total readonly />
          </div>
          <input type="hidden" name="refund_method" value="CASH" />
        </div>
        <div>
          <label class="label"><%= t('note') %></label>
          <input class="input" type="text" name="note" />
        </div>
        <button class="btn-primary w-full" type="submit"><%= t('save') %></button>
      </form>
    </div>

    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="table-base">
          <thead class="table-head">
            <tr>
              <th class="px-4 py-3"><%= t('date') %></th>
              <th class="px-4 py-3"><%= t('paymentReceiptNo') %></th>
              <th class="px-4 py-3"><%= t('returnedQuantity') %></th>
              <th class="px-4 py-3"><%= t('refundAmount') %></th>
              <th class="px-4 py-3"><%= t('paymentMode') %></th>
              <th class="px-4 py-3"><%= t('note') %></th>
              <th class="px-4 py-3"><%= t('recordedBy') %></th>
              <th class="table-action-sticky px-4 py-3 text-right"><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (!returns || returns.length === 0) { %>
              <tr>
                <td class="px-4 py-4 text-slate-500" colspan="8"><%= t('noData') %></td>
              </tr>
            <% } %>
            <% returns.forEach((row) => { %>
              <% const methodLabel = row.refund_method === 'BANK' ? t('methodBank') : row.refund_method === 'E_WALLET' ? t('methodEWallet') : row.refund_method === 'MIXED' ? t('methodMixed') : t('methodCash'); %>
              <tr class="table-row">
                <td class="px-4 py-3"><%= row.return_date %></td>
                <td class="px-4 py-3"><%= row.receipt_no || '-' %></td>
                <td class="px-4 py-3"><%= row.quantity %></td>
                <td class="px-4 py-3"><%= Number(row.refund_amount || 0) %></td>
                <td class="px-4 py-3"><%= Number(row.refund_amount || 0) > 0 ? methodLabel : '-' %></td>
                <td class="px-4 py-3"><%= row.note || '-' %></td>
                <td class="px-4 py-3"><%= row.recorded_by || '-' %></td>
                <td class="table-action-sticky px-4 py-3 text-right">
                  <div class="flex justify-end gap-2">
                    <a class="btn-outline" href="/records/jar-container-lending/returns/<%= row.id %>/print?autoprint=1" target="_blank"><%= t('print') %></a>
                    <form method="post" action="/records/jar-container-lending/returns/<%= row.id %>/delete" onsubmit="return confirm('<%= t('deleteReturnConfirm') %>');">
                      <button class="btn-outline" type="submit"><%= t('delete') %></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const maxTotal = Number("<%= Number(record.deposit_held || 0) %>");
    const cashInput = document.querySelector("[data-cash]");
    const bankInput = document.querySelector("[data-bank]");
    const walletInput = document.querySelector("[data-ewallet]");
    const totalInput = document.querySelector("[data-total]");
    const methodInput = document.querySelector('input[name="refund_method"]');
    if (!cashInput || !bankInput || !walletInput || !totalInput) return;

    const toSafe = (value) => {
      const num = Number(value || 0);
      if (Number.isNaN(num) || num < 0) return 0;
      return num;
    };
    const formatMoneyInput = (value) => {
      const safe = Math.round(toSafe(value) * 100) / 100;
      return safe > 0 ? String(safe) : "";
    };

    const recalc = () => {
      let cash = toSafe(cashInput.value);
      let bank = toSafe(bankInput.value);
      let wallet = toSafe(walletInput.value);
      let remainingTotal = Math.max(maxTotal, 0);
      const clamp = (value) => {
        const used = Math.min(value, remainingTotal);
        remainingTotal -= used;
        return used;
      };
      cash = clamp(cash);
      bank = clamp(bank);
      wallet = clamp(wallet);
      cashInput.value = formatMoneyInput(cash);
      bankInput.value = formatMoneyInput(bank);
      walletInput.value = formatMoneyInput(wallet);
      const total = cash + bank + wallet;
      totalInput.value = formatMoneyInput(total);
      if (methodInput) {
        methodInput.value = wallet > 0 ? "E_WALLET" : bank > 0 ? "BANK" : "CASH";
      }
    };

    [cashInput, bankInput, walletInput].forEach((el) => el.addEventListener("input", recalc));
    recalc();
  })();
</script>
<%- include('../partials/shell-end') %>
