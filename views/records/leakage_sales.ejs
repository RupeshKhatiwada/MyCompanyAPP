<%- include('../partials/shell-start', { title }) %>
<section class="py-8">
  <%
    const leakageRows = rows || [];
    const openCreditCount = leakageRows.filter((row) => Number(row.credit_amount || 0) > 0).length;
  %>

  <div class="page-header">
    <div class="card-toolbar">
      <div>
        <h1 class="text-3xl font-semibold"><%= t('leakageJarSalesTitle') %></h1>
        <p class="mt-1 text-slate-600"><%= t('leakageJarSalesSubtitle') %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn-outline" href="/records/payment-history?from=<%= from %>&to=<%= to %>&source=LEAKAGE_JAR_SALE"><%= t('paymentHistoryTitle') %></a>
        <a class="btn-primary" href="#leakage-entry"><%= t('addLeakageJarSaleTitle') %></a>
      </div>
    </div>
  </div>

  <% if (error) { %>
    <div class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= success %></div>
  <% } %>

  <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('quantity') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= totals.quantity %></p>
      <p class="mt-1 text-xs text-slate-500"><%= from %> -> <%= to %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('total') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= totals.total %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t('entries') %>: <%= leakageRows.length %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('paidAmount') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= totals.paid %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t('paymentHistoryTitle') %></p>
    </div>
    <div class="card p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t('creditAmount') %></p>
      <p class="mt-2 text-2xl font-semibold"><%= totals.credit %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t('openCredits') %>: <%= openCreditCount %></p>
    </div>
  </div>

  <div class="mt-6 card p-5">
    <div class="card-toolbar">
      <div class="surface-muted px-4 py-3 text-sm text-slate-600">
        <div><span class="font-medium text-slate-800"><%= t('selectedRange') %>:</span> <%= from %> -> <%= to %></div>
        <div class="mt-1"><span class="font-medium text-slate-800"><%= t('entries') %>:</span> <%= leakageRows.length %></div>
        <div class="mt-1"><span class="font-medium text-slate-800"><%= t('search') %>:</span> <%= q || '-' %></div>
      </div>
      <div class="flex flex-wrap gap-2 text-sm">
        <a class="btn-outline" href="/records/leakage-sales?from=<%= today %>&to=<%= today %>&q=<%= encodeURIComponent(q || '') %>"><%= t('presetToday') %></a>
        <a class="btn-outline" href="/records/leakage-sales?from=<%= monthStart %>&to=<%= today %>&q=<%= encodeURIComponent(q || '') %>"><%= t('presetThisMonth') %></a>
        <a class="btn-outline" href="/records/leakage-sales?from=<%= yearStart %>&to=<%= today %>&q=<%= encodeURIComponent(q || '') %>"><%= t('presetThisYear') %></a>
      </div>
    </div>

    <form class="mt-5 grid gap-3 lg:grid-cols-5" method="get" action="/records/leakage-sales">
      <div>
        <label class="label"><%= t('from') %></label>
        <input class="input mt-1" type="date" name="from" value="<%= from %>" />
      </div>
      <div>
        <label class="label"><%= t('to') %></label>
        <input class="input mt-1" type="date" name="to" value="<%= to %>" />
      </div>
      <div class="lg:col-span-2">
        <label class="label"><%= t('search') %></label>
        <input class="input mt-1" type="text" name="q" value="<%= q %>" placeholder="<%= t('searchPlaceholder') %>" />
      </div>
      <div class="flex items-end">
        <button class="btn-outline w-full" type="submit"><%= t('filter') %></button>
      </div>
    </form>
  </div>

  <div class="mt-6 grid gap-6 xl:grid-cols-[420px_minmax(0,1fr)]">
    <div class="card p-5" id="leakage-entry">
      <div>
        <h2 class="text-lg font-semibold"><%= t('addLeakageJarSaleTitle') %></h2>
        <p class="mt-1 text-sm text-slate-600"><%= t('leakageJarSalesSubtitle') %></p>
      </div>

      <form class="mt-5 space-y-5" method="post" action="/records/leakage-sales">
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label class="label"><%= t('date') %></label>
            <input class="input mt-1" type="date" name="sale_date" value="<%= to %>" required />
          </div>
          <div>
            <label class="label"><%= t('quantity') %></label>
            <input class="input mt-1" type="number" min="1" name="quantity" value="1" data-qty required />
          </div>
        </div>

        <div>
          <label class="label"><%= t('pricePerLeakageJar') %></label>
          <input class="input mt-1" type="number" min="0" step="0.01" name="unit_price" value="0" data-price required />
        </div>

        <div class="record-panel">
          <div class="card-toolbar">
            <div>
              <p class="record-panel-title"><%= t('paymentMethodLabel') %></p>
              <p class="mt-1 text-sm text-slate-600"><%= t('paymentHistoryEverythingHint') %></p>
            </div>
            <div class="text-right">
              <p class="record-panel-title"><%= t('totalAmount') %></p>
              <p class="mt-1 text-2xl font-semibold text-slate-900" id="leakageTotalPreview">0.00</p>
            </div>
          </div>

          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            <div>
              <label class="label text-xs"><%= t('methodCash') %></label>
              <input class="input mt-1" type="number" min="0" step="0.01" name="paid_cash_amount" value="" data-cash />
            </div>
            <div>
              <label class="label text-xs"><%= t('methodBank') %></label>
              <input class="input mt-1" type="number" min="0" step="0.01" name="paid_bank_amount" value="" data-bank />
            </div>
            <div>
              <label class="label text-xs"><%= t('methodEWallet') %></label>
              <input class="input mt-1" type="number" min="0" step="0.01" name="paid_ewallet_amount" value="" data-ewallet />
            </div>
          </div>

          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <div>
              <label class="label"><%= t('paidAmount') %></label>
              <input class="input mt-1 bg-slate-50" type="number" name="paid_amount" value="" data-paid-total readonly />
            </div>
            <div>
              <label class="label"><%= t('creditAmount') %></label>
              <input class="input mt-1 bg-slate-50" type="number" value="" data-credit-total readonly />
            </div>
          </div>
        </div>

        <div>
          <label class="label"><%= t('note') %></label>
          <input class="input mt-1" type="text" name="note" />
        </div>

        <input type="hidden" name="payment_method" value="CASH" />
        <button class="btn-primary w-full" type="submit"><%= t('save') %></button>
      </form>
    </div>

    <div class="card p-5">
      <div class="card-toolbar">
        <div>
          <h2 class="text-lg font-semibold"><%= t('leakageJarSalesTitle') %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= t('leakageJarSalesSubtitle') %></p>
        </div>
        <div class="surface-muted px-4 py-3 text-sm text-slate-600">
          <div><span class="font-medium text-slate-800"><%= t('entries') %>:</span> <%= leakageRows.length %></div>
          <div class="mt-1"><span class="font-medium text-slate-800"><%= t('openCredits') %>:</span> <%= openCreditCount %></div>
        </div>
      </div>

      <% if (!leakageRows.length) { %>
        <div class="empty-state mt-4">
          <p class="empty-state-title"><%= t('noData') %></p>
          <p class="empty-state-copy"><%= t('emptyRangeHint') %></p>
        </div>
      <% } else { %>
        <div class="mt-4 space-y-3">
          <% leakageRows.forEach((row) => { %>
            <%
              const paidCash = Number(row.paid_cash_amount || 0);
              const paidBank = Number(row.paid_bank_amount || 0);
              const paidEWallet = Number(row.paid_ewallet_amount || 0);
              const activeMethods = [paidCash > 0, paidBank > 0, paidEWallet > 0].filter(Boolean).length;
              const methodLabel = activeMethods > 1 ? t('methodMixed') : (paidBank > 0 ? t('methodBank') : (paidEWallet > 0 ? t('methodEWallet') : (paidCash > 0 ? t('methodCash') : '-')));
              const isPaid = Number(row.credit_amount || 0) <= 0;
              const isPartial = !isPaid && Number(row.paid_amount || 0) > 0;
              const statusLabel = isPaid ? t('paid') : (isPartial ? t('statusPartial') : t('unpaid'));
              const statusClass = isPaid ? 'status-pill-paid' : (isPartial ? 'status-pill-partial' : 'status-pill-unpaid');
            %>
            <div class="record-card">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="font-semibold text-slate-900"><%= row.sale_date %></p>
                    <span class="status-pill <%= statusClass %>"><%= statusLabel %></span>
                    <span class="status-pill status-pill-neutral"><%= methodLabel %></span>
                  </div>
                  <p class="mt-2 text-sm text-slate-600"><%= row.note || '-' %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= t('recordedBy') %>: <%= row.recorded_by || '-' %></p>
                </div>
                <div class="surface-muted min-w-[190px] px-4 py-3 text-right">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t('creditAmount') %></p>
                  <p class="mt-1 text-lg font-semibold text-slate-900"><%= row.credit_amount %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= t('totalAmount') %>: <%= row.total_amount %></p>
                </div>
              </div>

              <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                <div class="record-panel">
                  <p class="record-panel-title"><%= t('quickSummary') %></p>
                  <div class="mt-2 space-y-1 text-slate-700">
                    <div><span class="text-slate-500"><%= t('quantity') %>:</span> <%= row.quantity %></div>
                    <div><span class="text-slate-500"><%= t('price') %>:</span> <%= row.unit_price %></div>
                    <div><span class="text-slate-500"><%= t('totalAmount') %>:</span> <%= row.total_amount %></div>
                  </div>
                </div>
                <div class="record-panel">
                  <p class="record-panel-title"><%= t('paymentHistoryTitle') %></p>
                  <div class="mt-2 space-y-1 text-slate-700">
                    <div><span class="text-slate-500"><%= t('methodCash') %>:</span> <%= row.paid_cash_amount || 0 %></div>
                    <div><span class="text-slate-500"><%= t('methodBank') %>:</span> <%= row.paid_bank_amount || 0 %></div>
                    <div><span class="text-slate-500"><%= t('methodEWallet') %>:</span> <%= row.paid_ewallet_amount || 0 %></div>
                  </div>
                </div>
                <div class="record-panel">
                  <p class="record-panel-title"><%= t('paymentMode') %></p>
                  <div class="mt-2 space-y-1 text-slate-700">
                    <div><span class="text-slate-500"><%= t('paymentMethodLabel') %>:</span> <%= methodLabel %></div>
                    <div><span class="text-slate-500"><%= t('paidAmount') %>:</span> <%= row.paid_amount %></div>
                    <div><span class="text-slate-500"><%= t('creditAmount') %>:</span> <%= row.credit_amount %></div>
                  </div>
                </div>
                <div class="record-panel">
                  <p class="record-panel-title"><%= t('note') %></p>
                  <div class="mt-2 space-y-1 text-slate-700">
                    <div><span class="text-slate-500"><%= t('note') %>:</span> <%= row.note || '-' %></div>
                    <div><span class="text-slate-500"><%= t('recordedBy') %>:</span> <%= row.recorded_by || '-' %></div>
                  </div>
                </div>
              </div>

              <div class="record-actions">
                <% if (Number(row.credit_amount || 0) > 0) { %>
                  <a class="btn-outline btn-sm" href="/records/leakage-sales/<%= row.id %>/payments"><%= t('addPayment') %></a>
                <% } %>
                <a class="btn-outline btn-sm" href="/records/leakage-sales/<%= row.id %>/payments"><%= t('paymentHistory') %></a>
                <a class="btn-outline btn-sm" href="/records/leakage-sales/<%= row.id %>/edit"><%= t('edit') %></a>
                <details class="action-menu">
                  <summary class="btn-outline btn-sm">⋯</summary>
                  <div class="action-menu-panel">
                    <form method="post" action="/records/leakage-sales/<%= row.id %>/delete" onsubmit="return confirm('<%= t('deleteLeakageJarSaleConfirm') %>');">
                      <button class="action-menu-item action-menu-danger" type="submit"><%= t('delete') %></button>
                    </form>
                  </div>
                </details>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>

<script>
  (() => {
    const qtyInput = document.querySelector('[data-qty]');
    const priceInput = document.querySelector('[data-price]');
    const cashInput = document.querySelector('[data-cash]');
    const bankInput = document.querySelector('[data-bank]');
    const ewalletInput = document.querySelector('[data-ewallet]');
    const paidTotalInput = document.querySelector('[data-paid-total]');
    const creditInput = document.querySelector('[data-credit-total]');
    const totalPreview = document.getElementById('leakageTotalPreview');
    const paymentMethodInput = document.querySelector('input[name="payment_method"]');

    const clamp = (value) => {
      const num = Math.round(Math.max(0, Number(value || 0)) * 100) / 100;
      return Number.isNaN(num) ? 0 : num;
    };

    const recalc = () => {
      const qty = Math.max(0, Math.floor(Number(qtyInput?.value || 0)));
      const price = clamp(priceInput?.value || 0);
      const total = clamp(qty * price);
      let cash = clamp(cashInput?.value || 0);
      let bank = clamp(bankInput?.value || 0);
      let ewallet = clamp(ewalletInput?.value || 0);
      let remaining = total;
      const fit = (value) => {
        const use = Math.min(value, remaining);
        remaining = clamp(remaining - use);
        return use;
      };
      cash = fit(cash);
      bank = fit(bank);
      ewallet = fit(ewallet);
      const paid = clamp(cash + bank + ewallet);
      const credit = clamp(total - paid);
      if (cashInput) cashInput.value = cash > 0 ? cash : '';
      if (bankInput) bankInput.value = bank > 0 ? bank : '';
      if (ewalletInput) ewalletInput.value = ewallet > 0 ? ewallet : '';
      if (paidTotalInput) paidTotalInput.value = paid;
      if (creditInput) creditInput.value = credit;
      if (totalPreview) totalPreview.textContent = total.toFixed(2);
      if (paymentMethodInput) {
        paymentMethodInput.value = ewallet > 0 ? 'E_WALLET' : bank > 0 ? 'BANK' : 'CASH';
      }
    };

    [qtyInput, priceInput, cashInput, bankInput, ewalletInput].forEach((el) => {
      if (el) el.addEventListener('input', recalc);
    });
    recalc();
  })();
</script>
<%- include('../partials/shell-end') %>
