<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= brandName || 'AQUA MSK' %></title>
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
</head>
<body class="text-slate-900">
  <div class="min-h-screen px-4 py-8 lg:py-12">
    <div class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-5xl items-center">
      <div class="card grid w-full overflow-hidden lg:grid-cols-[0.92fr_1.08fr]">
        <div class="order-2 border-t border-slate-200 bg-slate-50/80 p-6 lg:order-1 lg:border-r lg:border-t-0 lg:p-8">
          <div class="flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-white">
              <% if (logoPath) { %>
                <img src="<%= logoPath %>" alt="logo" class="h-12 w-12 object-contain" />
              <% } else { %>
                <span class="text-xl font-bold text-aqua-700">A</span>
              <% } %>
            </div>
            <div>
              <p class="text-lg font-semibold"><%= brandName || 'AQUA MSK' %></p>
              <p class="text-xs text-slate-500"><%= brandTaglineText || t('brandTagline') %></p>
            </div>
          </div>
          <h1 class="mt-8 text-3xl font-semibold"><%= t('loginHeading') %></h1>
          <p class="mt-2 text-sm text-slate-600"><%= t('loginSubtitle') %></p>
          <div class="surface-muted mt-6 p-4 text-sm text-slate-600">
            <p><%= t('loginIntroLine1') %></p>
            <p class="mt-2"><%= t('loginIntroLine2') %></p>
          </div>
        </div>

        <div class="order-1 p-6 lg:order-2 lg:p-8">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-aqua-600 text-lg font-bold text-white">A</div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= brandTaglineText || t('brandTagline') %></p>
              <h2 class="text-2xl font-semibold"><%= t('loginTitle') %></h2>
            </div>
          </div>
          <p class="mt-3 text-sm text-slate-600"><%= t('enterCredentials') %></p>

          <% if (created) { %>
            <div class="mt-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= t('adminCreated') %></div>
          <% } %>
          <% if (error) { %>
            <div class="mt-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700"><%= error %></div>
          <% } %>

          <form method="post" action="/login" class="mt-6 space-y-4">
            <div>
              <label class="label" for="username"><%= t('username') %></label>
              <input id="username" class="input mt-1" type="text" name="username" autocomplete="username" required />
            </div>
            <div>
              <label class="label" for="password"><%= t('password') %></label>
              <input id="password" class="input mt-1" type="password" name="password" autocomplete="current-password" required />
            </div>
            <button class="btn-primary w-full" type="submit"><%= t('loginButton') %></button>
          </form>

          <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm">
            <a class="font-medium text-aqua-700 hover:text-aqua-800" href="/recover"><%= t('forgotPassword') %></a>
            <span class="text-slate-500"><%= t('loginIntroLine1') %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
